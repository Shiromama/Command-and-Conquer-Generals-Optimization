+    Counters counters;
+    Counters *previous=nullptr;
+    const char *kind;
+    unsigned object=0, frame=0;
+    Coord3D from{}, to{};
+    LARGE_INTEGER start{};
+    bool enabled=false, fallback=false;
+    Trace(const char *k, const Object *obj, const Coord3D *f, const Coord3D *t):heap(heapAllowed()),kind(k) {
+        // Avoid QPC, file opens and list scans on normal runs and in network/replay modes.
+        if(!allowed() || (!getenv("ZH_PF_LOG") && !getenv("ZH_PF_FRAME") && !getenv("ZH_PF_OPS"))) return;
