+// PROJECT PATCH (T-036): test-only logic phase timing (ZH_PERF_LOGIC=<csv>).
+// Separates object updates, AI, build assistant, partition manager, destroy processing and the
+// remaining tail so a wreck-field slowdown can be attributed without a full profiler.
+static FILE *s_zhLogicLog = nullptr;
+static Bool s_zhLogicInit = FALSE;
+static LARGE_INTEGER s_zhLogicFreq;
+static void zhLogicMark(LARGE_INTEGER *t) { if (s_zhLogicLog != nullptr) QueryPerformanceCounter(t); }
+static double zhLogicMs(const LARGE_INTEGER &a, const LARGE_INTEGER &b)
+{
+	return (double)(b.QuadPart - a.QuadPart) * 1000.0 / (double)s_zhLogicFreq.QuadPart;
+}
