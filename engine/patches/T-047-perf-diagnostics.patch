+// PROJECT PATCH (T-047): test-only phase timer. Appends "<name>,<ms>" to ZH_PERF_SPLIT so a slow
+// client frame can be attributed to drawable updates, terrain visuals, display or particles.
+static void logClientPhase(const char *name, LARGE_INTEGER start, LARGE_INTEGER freq)
+{
+	static FILE *phaseFile = nullptr;
+	static Bool phaseInit = FALSE;
+	if (!phaseInit)
+	{
+		phaseInit = TRUE;
+		const char *splitPath = getenv("ZH_PERF_SPLIT");
+		if (splitPath && *splitPath)
+			phaseFile = fopen(splitPath, "a");
+	}
+	if (phaseFile != nullptr)
+	{
+		LARGE_INTEGER end;
+		QueryPerformanceCounter(&end);
+		fprintf(phaseFile, "%s,%.4f\n", name,
+			(double)(end.QuadPart - start.QuadPart) * 1000.0 / (double)freq.QuadPart);
+		fflush(phaseFile);
+	}
+}
