@@ -0,0 +1,122 @@
+// T-110: diagnostic-only group clearance memo and route guard measurement.
+#include <array>
+#include <bit>
+
+namespace groupCacheProbe {
+
+struct Entry {
+    unsigned generation = 0;
+    int x = 0, y = 0, layer = 0, diameter = 0, result = 0;
+    bool crusher = false;
+};
+
+inline std::array<Entry, 8192> entries;
+inline unsigned generation = 0;
+inline unsigned ordinal = 0;
+
+inline FILE *log()
+{
+    static FILE *file = []() -> FILE * {
+        const char *name = std::getenv("ZH_GROUP_CACHE_LOG");
+        FILE *output = name ? std::fopen(name, "w") : nullptr;
+        if (output) {
+            std::setvbuf(output, nullptr, _IOFBF, 262144);
+            std::fprintf(output, "frame,ordinal,mode,revision,fixed_revision,from_x,from_y,from_z,to_x,to_y,to_z,diameter,crusher,returned,route_hash,calls,hits,checked,mismatches,usec\n");
+        }
+        return output;
+    }();
+    return file;
+}
+
+struct RouteProbe;
+inline RouteProbe *active = nullptr;
+
+struct RouteProbe {
+    RouteProbe(const Coord3D &from, const Coord3D &to, int diameter, bool crusher)
+        : from(from), to(to), diameter(diameter), crusher(crusher)
+    {
+        if (!log() || !TheGameLogic || !TheGameLogic->isInReplayGame()) return;
+        frame = TheGameLogic->getFrame();
+        if (!lastStandCensus::capture(frame)) return;
+        sequence = ++ordinal;
+        revision = lastStandCensus::navigationRevision;
+        fixedRevision = lastStandCensus::fixedOccupancyRevision;
+        previous = active;
+        // Assign two calls per pair to opposite modes, rotating order to break periodicity.
+        unsigned pair = (sequence - 1) / 2;
+        unsigned mixed = pair * 0x9e3779b9u;
+        verify = frame < 14730;
+        memo = verify || (((sequence - 1) ^ (mixed >> 31)) & 1) != 0;
+        if (++generation == 0) {
+            for (auto &entry : entries) entry.generation = 0;
+            ++generation;
+        }
+        stamp = generation;
+        active = memo ? this : nullptr;
+        QueryPerformanceCounter(&begin);
+    }
+
+    ~RouteProbe()
+    {
+        if (sequence) active = previous;
+    }
+
+    void finish(Path *path)
+    {
+        if (!sequence) return;
+        LARGE_INTEGER end{}, frequency{};
+        QueryPerformanceCounter(&end);
+        QueryPerformanceFrequency(&frequency);
+        double usec = (end.QuadPart - begin.QuadPart) * 1000000.0 / frequency.QuadPart;
+        unsigned long long hash = 14695981039346656037ull;
+        if (path) for (const PathNode *node = path->getFirstNode(); node; node = node->getNext()) {
+            const Coord3D &pos = *node->getPosition();
+            for (float component : {pos.x, pos.y, pos.z}) {
+                hash ^= std::bit_cast<unsigned>(component);
+                hash *= 1099511628211ull;
+            }
+            hash ^= static_cast<unsigned>(node->getLayer());
+            hash *= 1099511628211ull;
+        }
+        std::fprintf(log(), "%u,%u,%s,%u,%u,%u,%u,%u,%u,%u,%u,%d,%u,%u,%llu,%u,%u,%u,%u,%.3f\n",
+            frame, sequence, verify ? "verify" : memo ? "memo" : "control", revision, fixedRevision,
+            std::bit_cast<unsigned>(from.x), std::bit_cast<unsigned>(from.y), std::bit_cast<unsigned>(from.z),
+            std::bit_cast<unsigned>(to.x), std::bit_cast<unsigned>(to.y), std::bit_cast<unsigned>(to.z),
+            diameter, unsigned(crusher), unsigned(path != nullptr), hash, calls, hits, checked, mismatches, usec);
+    }
+
+    Coord3D from, to;
+    int diameter;
+    bool crusher;
+    bool memo = false, verify = false;
+    unsigned frame = 0, sequence = 0, stamp = 0, revision = 0, fixedRevision = 0;
+    unsigned calls = 0, hits = 0, checked = 0, mismatches = 0;
+    LARGE_INTEGER begin{};
+    RouteProbe *previous = nullptr;
+};
+
+template<class Compute>
+int clearance(int x, int y, int layer, int diameter, bool crusher, Compute compute)
+{
+    RouteProbe *probe = active;
+    if (!probe) return compute();
+    ++probe->calls;
+    unsigned key = unsigned(x) * 73856093u ^ unsigned(y) * 19349663u ^
+        unsigned(layer) * 83492791u ^ unsigned(diameter) * 2654435761u ^ unsigned(crusher);
+    auto &entry = entries[key & (entries.size() - 1)];
+    if (entry.generation == probe->stamp && entry.x == x && entry.y == y &&
+        entry.layer == layer && entry.diameter == diameter && entry.crusher == crusher) {
+        const int memoized = entry.result;
+        ++probe->hits;
+        if (!probe->verify) return memoized;
+        const int original = compute();
+        ++probe->checked;
+        if (original != memoized) ++probe->mismatches;
+        return original;
+    }
+    const int result = compute();
+    entry = {probe->stamp, x, y, layer, diameter, result, crusher};
+    return result;
+}
+
+} // namespace groupCacheProbe
