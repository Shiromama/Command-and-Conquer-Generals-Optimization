+#pragma once
+
+#include <cstdlib>
+
+namespace lastStandCensus {
+
+struct Context {
+    const char *reason = "direct";
+    unsigned actor = 0;
+    unsigned target = 0;
+    unsigned surfaces = 0;
+    int queueAge = -1;
+    int queueDepth = -1;
+    bool blocked = false;
+};
+
+inline Context context;
+inline unsigned navigationRevision = 0;
+inline unsigned fixedOccupancyRevision = 0;
+
+inline const char *outputPath()
+{
+    static const char *path = std::getenv("ZH_PATH_CENSUS");
+    return path;
+}
+
+inline unsigned setting(const char *name, unsigned fallback)
+{
+    const char *value = std::getenv(name);
+    return value ? static_cast<unsigned>(std::strtoul(value, nullptr, 10)) : fallback;
+}
+
+inline bool capture(unsigned frame)
+{
+    static const unsigned first = setting("ZH_PATH_CENSUS_FIRST", 14700);
+    static const unsigned last = setting("ZH_PATH_CENSUS_LAST", 17400);
+    return outputPath() && frame >= first && frame <= last;
+}
+
+class ContextScope {
+public:
+    explicit ContextScope(bool enabled) : enabled(enabled), previous(context) {}
+    ~ContextScope() { if (enabled) context = previous; }
+
+private:
+    bool enabled;
+    Context previous;
+};
+
+} // namespace lastStandCensus
