+	// same frame. (An earlier build used the previous frame's start, which shifted the interval
+	// by one row and made the residual meaningless.)
+	s_zhAttrInterval = zhAttrMs(s_zhAttrStart, end);
+	s_zhAttrPrevEnd = end;
+	s_zhAttrHavePrevEnd = true;
+	// The phases are contiguous by construction, so the only time this logger cannot attribute
+	// is the gap between the previous frame's pacer exit and this frame's start (loop
+	// bookkeeping, profiling resets). It must be ~0; a large value means something outside the
+	// phase marks is blocking the loop.
+	const double gap = s_zhAttrLoopGap;
+	fprintf(s_zhAttrFile,
+		"%llu,%d,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,"
+		"%.3f,%.3f,%.3f,%.3f,%.3f,"
+		"%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,"
+		"%.1f,%s,%s,"
+		"%d,%.1f,%s,"
+		"%d,%.3f,%d,"
+		"%u,%u\n",
