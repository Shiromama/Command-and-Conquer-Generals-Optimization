+
+// T-127 render-state snapshot (first slice): per-drawable transform matrix,
+// stored in an ID-indexed side table so the Drawable layout is untouched.
+namespace {
+bool s_zhRenderSnapshot = [] {
+	const char *value=std::getenv("ZH_RENDER_SNAPSHOT");
+	return value && value[0]=='1' && value[1]=='\0';
+}();
+std::vector<Matrix3D> s_zhRenderSnapshotMatrices;
+std::vector<unsigned> s_zhRenderSnapshotGeneration;
+unsigned s_zhRenderSnapshotCurrent = 0;
+}
+bool zhRenderSnapshotActive() { return s_zhRenderSnapshot; }
+void zhRenderSnapshotCapture()
+{
+	if (!s_zhRenderSnapshot)
+		return;
+	++s_zhRenderSnapshotCurrent;
+	if (s_zhRenderSnapshotCurrent == 0) {
+		std::fill(s_zhRenderSnapshotGeneration.begin(), s_zhRenderSnapshotGeneration.end(), 0);
+		s_zhRenderSnapshotCurrent = 1;
+	}
+	for (Drawable *d=TheGameClient->getDrawableList(); d; d=d->getNextDrawable())
+	{
+		const Matrix3D *m=d->getTransformMatrix();
+		if (!m)
+			continue;
+		const unsigned id=static_cast<unsigned>(d->getID());
+		if (id >= s_zhRenderSnapshotMatrices.size()) {
+			s_zhRenderSnapshotMatrices.resize(id + 1);
+			s_zhRenderSnapshotGeneration.resize(id + 1, 0);
+		}
+		s_zhRenderSnapshotMatrices[id]=*m;
+		s_zhRenderSnapshotGeneration[id]=s_zhRenderSnapshotCurrent;
+	}
+}
+const Matrix3D *zhRenderSnapshotMatrix(const Drawable *drawable)
+{
+	if (!s_zhRenderSnapshot)
+		return nullptr;
+	const unsigned id=static_cast<unsigned>(drawable->getID());
+	if (id >= s_zhRenderSnapshotGeneration.size() ||
+		s_zhRenderSnapshotGeneration[id] != s_zhRenderSnapshotCurrent)
+		return nullptr;
+	return &s_zhRenderSnapshotMatrices[id];
+}
