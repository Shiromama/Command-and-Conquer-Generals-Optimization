diff --git a/Core/GameEngine/Include/Common/EpochBucketQueue.h b/Core/GameEngine/Include/Common/EpochBucketQueue.h
new file mode 100644
index 0000000..8b49b38
--- /dev/null
+++ b/Core/GameEngine/Include/Common/EpochBucketQueue.h
@@ -0,0 +1,152 @@
+#pragma once
+
+#include <array>
+#include <bit>
+#include <cstdint>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+
+class BucketQueue {
+public:
+    static constexpr unsigned costLimit=1u<<17;
+
+    explicit BucketQueue(bool) : m_entries(slotCount), m_buckets(costLimit) {}
+
+    void begin()
+    {
+        if (++m_epoch==0) {
+            for (auto &entry:m_entries)
+                entry.epoch=0;
+            ++m_epoch;
+        }
+        m_low.fill(0);
+        m_middle.fill(0);
+        m_high.fill(0);
+        m_root=0;
+        m_size=0;
+        ordered.clear();
+    }
+
+    void insert(void *cell,unsigned cost)
+    {
+        if (cost>=costLimit)
+            throw std::runtime_error("recorded cost exceeds the bounded queue");
+        const unsigned slot=findSlot(cell);
+        auto &entry=m_entries[slot];
+        auto &bucket=m_buckets[cost];
+        entry.cost=cost;
+        entry.next=absent;
+        if (occupied(cost)) {
+            entry.previous=bucket.last;
+            m_entries[bucket.last].next=slot;
+            bucket.last=slot;
+        } else {
+            entry.previous=absent;
+            bucket={slot,slot};
+            activate(cost);
+        }
+        ++m_size;
+    }
+
+    void remove(void *cell) { removeSlot(findSlot(cell)); }
+
+    void *top() const
+    {
+        return m_root ? m_entries[m_buckets[firstCost()].first].cell : nullptr;
+    }
+
+    unsigned size() const { return m_size; }
+
+    void sortForCleanup()
+    {
+        ordered.clear();
+        while (m_root) {
+            const auto head=m_buckets[firstCost()].first;
+            ordered.push_back(m_entries[head].cell);
+            removeSlot(head);
+        }
+    }
+
+    std::vector<void*> ordered;
+
+private:
+    static constexpr unsigned absent=std::numeric_limits<unsigned>::max();
+    static constexpr unsigned slotCount=65536;
+    struct Entry {
+        void *cell=nullptr;
+        unsigned epoch=0,cost=0,previous=absent,next=absent;
+    };
+    struct Bucket { unsigned first,last; };
+
+    static constexpr std::uint32_t bit(unsigned index) {return std::uint32_t{1}<<(index&31u);}
+    bool occupied(unsigned cost) const {return (m_low[cost>>5]&bit(cost))!=0;}
+
+    void activate(unsigned cost)
+    {
+        const unsigned low=cost>>5, middle=low>>5, high=middle>>5;
+        if (m_low[low]==0 && m_middle[middle]==0 && m_high[high]==0)
+            m_root|=bit(high);
+        m_low[low]|=bit(cost);
+        m_middle[middle]|=bit(low);
+        m_high[high]|=bit(middle);
+    }
+
+    void deactivate(unsigned cost)
+    {
+        const unsigned low=cost>>5, middle=low>>5, high=middle>>5;
+        m_low[low]&=~bit(cost);
+        if (m_low[low]) return;
+        m_middle[middle]&=~bit(low);
+        if (m_middle[middle]) return;
+        m_high[high]&=~bit(middle);
+        if (m_high[high]) return;
+        m_root&=~bit(high);
+    }
+
+    unsigned firstCost() const
+    {
+        const unsigned high=std::countr_zero(m_root);
+        const unsigned middle=(high<<5)+std::countr_zero(m_high[high]);
+        const unsigned low=(middle<<5)+std::countr_zero(m_middle[middle]);
+        return (low<<5)+std::countr_zero(m_low[low]);
+    }
+
+    unsigned findSlot(void *cell)
+    {
+        unsigned slot=static_cast<unsigned>((reinterpret_cast<std::uintptr_t>(cell)>>4)*2654435761u)&(slotCount-1);
+        for (;;) {
+            auto &entry=m_entries[slot];
+            if (entry.epoch!=m_epoch) {
+                entry.cell=cell;
+                entry.epoch=m_epoch;
+                return slot;
+            }
+            if (entry.cell==cell)
+                return slot;
+            slot=(slot+1)&(slotCount-1);
+        }
+    }
+
+    void removeSlot(unsigned slot)
+    {
+        const auto &entry=m_entries[slot];
+        auto &bucket=m_buckets[entry.cost];
+        if (entry.previous==absent) bucket.first=entry.next;
+        else m_entries[entry.previous].next=entry.next;
+        if (entry.next==absent) bucket.last=entry.previous;
+        else m_entries[entry.next].previous=entry.previous;
+        if (bucket.first==absent)
+            deactivate(entry.cost);
+        --m_size;
+    }
+
+    std::vector<Entry> m_entries;
+    std::vector<Bucket> m_buckets;
+    unsigned m_epoch=0;
+    unsigned m_size=0;
+    std::uint32_t m_root=0;
+    std::array<std::uint32_t,(costLimit>>5)> m_low{};
+    std::array<std::uint32_t,(costLimit>>10)> m_middle{};
+    std::array<std::uint32_t,(costLimit>>15)> m_high{};
+};
diff --git a/Core/GameEngine/Include/Common/FormationZoneHalo.h b/Core/GameEngine/Include/Common/FormationZoneHalo.h
new file mode 100644
index 0000000..df2eee2
--- /dev/null
+++ b/Core/GameEngine/Include/Common/FormationZoneHalo.h
@@ -0,0 +1,46 @@
+#pragma once
+
+#include "Common/ZoneHalo.h"
+
+namespace formationZoneHalo {
+
+inline bool *active=nullptr;
+
+inline void invalidate()
+{
+    if (active)
+        *active=false;
+}
+
+template<int BlockSize>
+class Scope {
+public:
+    Scope(bool enabled,int width,int height)
+    {
+        if (!enabled || active || width<=0 || height<=0 || width>128 || height>128)
+            return;
+        m_cache.begin(width,height);
+        m_valid=true;
+        active=&m_valid;
+    }
+
+    Scope(const Scope&)=delete;
+    Scope& operator=(const Scope&)=delete;
+
+    ~Scope()
+    {
+        if (active==&m_valid)
+            active=nullptr;
+    }
+
+    bool covers(int x,int y) const {return m_valid && m_cache.covers(x,y);}
+
+    template<class ReadBlock>
+    bool allows(int x,int y,ReadBlock read) {return m_cache.allows(x,y,read);}
+
+private:
+    static inline ZoneHalo<BlockSize> m_cache;
+    bool m_valid=false;
+};
+
+} // namespace formationZoneHalo
diff --git a/Core/GameEngine/Include/Common/GenericScriptOpcodes.inc b/Core/GameEngine/Include/Common/GenericScriptOpcodes.inc
new file mode 100644
index 0000000..248289a
--- /dev/null
+++ b/Core/GameEngine/Include/Common/GenericScriptOpcodes.inc
@@ -0,0 +1,79 @@
+// Included inside lastStandResidual after Frame and active are defined.
+struct OpcodeRecord {
+    unsigned calls=0, samples=0;
+    LONGLONG counts=0;
+};
+
+inline constexpr unsigned opcodeLimit=1024;
+inline std::array<OpcodeRecord,opcodeLimit> conditionOpcodes{},actionOpcodes{};
+inline unsigned actionDepth=0;
+inline unsigned sampleState=0x33d6bdacu;
+
+inline FILE *opcodeOutput()
+{
+    static FILE *file=[] {
+        const char *path=std::getenv("ZH_TEAM_OPCODE_LOG");
+        return path && *path ? std::fopen(path,"w") : nullptr;
+    }();
+    return file;
+}
+
+class OpcodeScope {
+public:
+    OpcodeScope(GenericContext context,unsigned opcode)
+    {
+        if (!active || active->generic!=context || !opcodeOutput() || opcode>=opcodeLimit)
+            return;
+        if (context==GenericContext::Action) {
+            m_action=true;
+            if (actionDepth++!=0)
+                return;
+        }
+        auto &census=context==GenericContext::Action ? actionOpcodes : conditionOpcodes;
+        OpcodeRecord &entry=census[opcode];
+        ++entry.calls;
+        sampleState ^= sampleState<<13;
+        sampleState ^= sampleState>>17;
+        sampleState ^= sampleState<<5;
+        if ((sampleState&31)==0) {
+            m_sample=&entry;
+            QueryPerformanceCounter(&m_start);
+        }
+    }
+
+    ~OpcodeScope()
+    {
+        if (m_sample) {
+            LARGE_INTEGER end{};
+            QueryPerformanceCounter(&end);
+            ++m_sample->samples;
+            m_sample->counts+=end.QuadPart-m_start.QuadPart;
+        }
+        if (m_action)
+            --actionDepth;
+    }
+
+private:
+    OpcodeRecord *m_sample=nullptr;
+    LARGE_INTEGER m_start{};
+    bool m_action=false;
+};
+
+inline void writeOpcodes(double msPerCount)
+{
+    FILE *file=opcodeOutput();
+    if (!file)
+        return;
+    std::fputs("kind,opcode,calls,samples,sampled_ms\n",file);
+    const auto output=[&](const char *kind,const auto &rows) {
+        for (unsigned opcode=0;opcode<rows.size();++opcode) {
+            const OpcodeRecord &entry=rows[opcode];
+            if (entry.calls)
+                std::fprintf(file,"%s,%u,%u,%u,%.6f\n",kind,opcode,entry.calls,
+                    entry.samples,static_cast<double>(entry.counts)*msPerCount);
+        }
+    };
+    output("condition",conditionOpcodes);
+    output("action",actionOpcodes);
+    std::fflush(file);
+}
