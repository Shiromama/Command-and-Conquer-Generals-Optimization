diff --git a/GeneralsMD/Code/GameEngine/Include/GameLogic/DenseObjectIds.h b/GeneralsMD/Code/GameEngine/Include/GameLogic/DenseObjectIds.h
new file mode 100644
index 0000000..8ac2ad1
--- /dev/null
+++ b/GeneralsMD/Code/GameEngine/Include/GameLogic/DenseObjectIds.h
@@ -0,0 +1,28 @@
+#pragma once
+
+#include <algorithm>
+#include <memory>
+#include <new>
+
+template<class Object,unsigned Capacity=1u<<18>
+class DenseObjectIds {
+public:
+    void enable()
+    {
+        if (!m_entries)
+            m_entries.reset(new(std::nothrow) Object*[Capacity]{});
+    }
+
+    bool covers(unsigned id) const { return m_entries && id<Capacity; }
+    Object *get(unsigned id) const { return m_entries[id]; }
+    void set(unsigned id,Object *object) { m_entries[id]=object; }
+
+    void clear()
+    {
+        if (m_entries)
+            std::fill_n(m_entries.get(),Capacity,nullptr);
+    }
+
+private:
+    std::unique_ptr<Object*[]> m_entries;
+};
