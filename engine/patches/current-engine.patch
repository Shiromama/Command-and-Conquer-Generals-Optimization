+{
+    static FILE *file = [] {
+        const char *name = std::getenv("ZH_FORMATION_LOCAL_OCCUPANCY");
+        FILE *out = name ? std::fopen(name, "w") : nullptr;
+        if (out) {
+            std::setvbuf(out, nullptr, _IOFBF, 65536);
+            std::fprintf(out, "scope,frame,previous_frame,revision,local_match,changed_cells,area,recorded,validation_us,build_us,legacy_return\n");
+        }
+        return out;
+    }();
