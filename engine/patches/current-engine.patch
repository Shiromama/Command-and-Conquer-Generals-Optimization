diff --git a/Core/GameEngine/Source/GameLogic/AI/FirstLineStep.h b/Core/GameEngine/Source/GameLogic/AI/FirstLineStep.h
new file mode 100644
index 0000000..7ed30e4
--- /dev/null
+++ b/Core/GameEngine/Source/GameLogic/AI/FirstLineStep.h
@@ -0,0 +1,17 @@
+#pragma once
+
+struct LineFirstStep {
+    int x, y;
+};
+
+// Match the first cell after the origin in the engine's supercover traversal.
+inline LineFirstStep firstLineStep(int x, int y, int goalX, int goalY)
+{
+    const int sx = goalX >= x ? 1 : -1;
+    const int sy = goalY >= y ? 1 : -1;
+    const int dx = (goalX - x) * sx;
+    const int dy = (goalY - y) * sy;
+    if (dx >= dy)
+        return dx / 2 + dy >= dx ? LineFirstStep{x, y + sy} : LineFirstStep{x + sx, y};
+    return dy / 2 + dx >= dy ? LineFirstStep{x + sx, y} : LineFirstStep{x, y + sy};
+}
diff --git a/Core/GameEngine/Source/GameLogic/AI/FootprintPolicy.h b/Core/GameEngine/Source/GameLogic/AI/FootprintPolicy.h
new file mode 100644
index 0000000..80eb8dd
--- /dev/null
+++ b/Core/GameEngine/Source/GameLogic/AI/FootprintPolicy.h
@@ -0,0 +1,154 @@
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <optional>
+
+namespace footprintPolicy {
+using Id = std::uint32_t;
+enum class Occupancy { Empty = 0, Goal = 1, Moving = 2, Fixed = 3, GoalOtherMoving = 5 };
+enum class Terrain { Obstacle = 4, BridgeImpassable = 5, Impassable = 6 };
+
+struct Cell {
+    Terrain terrain;
+    Occupancy occupancy;
+    Id position, goal, aircraft, obstacle;
+    bool aircraftGoal;
+};
+
+struct Actor {
+    Id id, ignored;
+    bool exists, hasAI, infantry, aircraftDestination;
+    bool operator==(const Actor &) const = default;
+};
+
+struct Unit {
+    Id id;
+    bool exists, ally, hasAI, idle, infantry;
+    bool operator==(const Unit &) const = default;
+};
+
+struct Area {
+    int x0, y0, x1, y1;
+    bool operator==(const Area &) const = default;
+};
+
+struct Movement {
+    bool canMove = true;
+    bool allyMoving = false;
+    bool allyGoal = false;
+    bool enemyFixed = false;
+    unsigned allyFixedCount = 0;
+    bool operator==(const Movement &) const = default;
+};
+
+// Missing cell means outside the grid. Missing facts means the worker does
+// not know the answer. An absent object is represented by Unit::exists.
+template<bool retailGenerals, bool infantryPassesInfantry, class ReadCell, class ReadUnit, class ReadCrush>
+std::optional<Movement> movement(const Actor &actor, Area bounds, bool transient,
+    ReadCell readCell, ReadUnit readUnit, ReadCrush readCrush)
+{
+    Movement answer;
+    if (!actor.exists)
+        return answer;
+    std::array<Id, 5> allies{};
+    unsigned saved = 0;
+    for (int x = bounds.x0; x < bounds.x1; ++x) {
+        for (int y = bounds.y0; y < bounds.y1; ++y) {
+            const auto cell = readCell(x,y);
+            if (!cell) {
+                answer.canMove = false;
+                return answer;
+            }
+            const auto flags = cell->occupancy;
+            if (flags == Occupancy::Goal || flags == Occupancy::GoalOtherMoving)
+                answer.allyGoal = true;
+            if (flags == Occupancy::Empty || cell->position == actor.id ||
+                cell->position == actor.ignored)
+                continue;
+            const bool moving = flags == Occupancy::Moving || flags == Occupancy::GoalOtherMoving;
+            if (!moving && flags != Occupancy::Fixed)
+                continue;
+            const auto unit = readUnit(cell->position);
+            if (!unit)
+                return std::nullopt;
+            if (!unit->exists)
+                continue;
+            if (moving && unit->ally)
+                answer.allyMoving = true;
+            if ((moving && !transient) || (actor.hasAI && actor.ignored == unit->id))
+                continue;
+            if constexpr (infantryPassesInfantry) {
+                if (actor.infantry && unit->infantry)
+                    continue;
+            }
+            if (unit->ally) {
+                if (!unit->hasAI || (retailGenerals && !unit->idle)) {
+                    answer.canMove = false;
+                    return answer;
+                }
+                bool found = false;
+                for (unsigned i = 0; i < saved; ++i)
+                    found |= allies[i] == unit->id;
+                if (!found) {
+                    ++answer.allyFixedCount;
+                    if (saved < allies.size())
+                        allies[saved++] = unit->id;
+                }
+            } else {
+                const auto canCrush = readCrush(unit->id);
+                if (!canCrush)
+                    return std::nullopt;
+                answer.enemyFixed |= !*canCrush;
+            }
+        }
+    }
+    return answer;
+}
+
+template<bool retailGenerals, class ReadCell, class ReadUnit, class ReadCrush>
+std::optional<bool> destination(const Actor &actor, Area bounds, ReadCell readCell, ReadUnit readUnit,
+    ReadCrush readCrush)
+{
+    const Id object = actor.hasAI ? actor.id : 0;
+    const Id ignored = actor.hasAI ? actor.ignored : 0;
+    for (int x = bounds.x0; x < bounds.x1; ++x) {
+        for (int y = bounds.y0; y < bounds.y1; ++y) {
+            const auto cell = readCell(x,y);
+            if (!cell)
+                return false;
+            if (actor.aircraftDestination) {
+                if (cell->aircraftGoal && cell->aircraft != object)
+                    return false;
+                continue;
+            }
+            if (cell->terrain == Terrain::Obstacle) {
+                if (ignored && cell->obstacle == ignored)
+                    continue;
+                return false;
+            }
+            if (!retailGenerals && (cell->terrain == Terrain::BridgeImpassable || cell->terrain == Terrain::Impassable))
+                return false;
+            if (cell->occupancy == Occupancy::Empty || !cell->goal || cell->goal == object || cell->goal == ignored)
+                continue;
+            if (!actor.exists)
+                return false;
+            const auto unit = readUnit(cell->goal);
+            if (!unit)
+                return std::nullopt;
+            if (!unit->exists)
+                continue;
+            if (unit->ally)
+                return false;
+            if (cell->occupancy == Occupancy::Fixed) {
+                const auto canCrush = readCrush(unit->id);
+                if (!canCrush)
+                    return std::nullopt;
+                if (!*canCrush)
+                    return false;
+            }
+        }
+    }
+    return true;
+}
+}
diff --git a/Core/GameEngine/Source/GameLogic/AI/FormationOccupancy.inc b/Core/GameEngine/Source/GameLogic/AI/FormationOccupancy.inc
