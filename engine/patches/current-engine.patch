+extern int g_zhAttrNukeTicks;
+
+// True when ZH_ATTR_SAMPLE=1; per-call timing is skipped otherwise.
+extern bool g_zhAttrSample;
+
+// PROJECT PATCH (T-051): true when ZH_ATTR_LOG is active; lets the client/logic timers run
+// without ZH_PERF_SPLIT.
+bool zhAttrLogging();
