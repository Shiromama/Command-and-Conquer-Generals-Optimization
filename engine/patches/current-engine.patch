diff --git a/Core/Libraries/Source/WWVegas/WWLib/ZhLockStats.h b/Core/Libraries/Source/WWVegas/WWLib/ZhLockStats.h
new file mode 100644
index 0000000..2927563
--- /dev/null
+++ b/Core/Libraries/Source/WWVegas/WWLib/ZhLockStats.h
@@ -0,0 +1,113 @@
+/*
+**	Command & Conquer Generals Zero Hour(tm)
+**	PROJECT PATCH (T-068): allocator/string lock instrumentation.
+**
+**	Cumulative counters behind an env switch (ZH_LOCK_LOG=<path>) so the share of frame time
+**	spent inside the object-pool and AsciiString critical sections can be measured before
+**	changing either. When the variable is unset the only cost is one cached branch per lock.
+*/
+
+#pragma once
+
+#include <stdlib.h>
+#include <windows.h>
+
+struct ZhLockTotals
+{
+	unsigned long long calls;
+	unsigned long long ticks;
+};
+
+inline ZhLockTotals &zhPoolLockTotals()
+{
+	static ZhLockTotals totals = {0, 0};
+	return totals;
+}
+
+inline ZhLockTotals &zhStringLockTotals()
+{
+	static ZhLockTotals totals = {0, 0};
+	return totals;
+}
+
+inline bool zhLockLogEnabled()
+{
+	static int enabled = -1;
+	if (enabled < 0)
+	{
+		const char *path = static_cast<const char*>(nullptr);
+		enabled = (path && *path) ? 1 : 0;
+	}
+	return enabled != 0;
+}
+
+inline long long zhLockNow()
+{
+	LARGE_INTEGER counter;
+	QueryPerformanceCounter(&counter);
+	return (long long)counter.QuadPart;
+}
+
+inline long long zhLockFrequency()
+{
+	static long long frequency = 0;
+	if (frequency == 0)
+	{
+		LARGE_INTEGER f;
+		QueryPerformanceFrequency(&f);
+		frequency = f.QuadPart;
+	}
+	return frequency;
+}
+
+// Cost of one timed call's measurement overhead (a QueryPerformanceCounter pair), in microseconds.
+// Measured once so the reported lock time can be corrected for the cost of measuring it.
+inline double zhLockQpcPairUs()
+{
+	static double pairUs = -1.0;
+	if (pairUs < 0.0)
+	{
+		const int samples = 2000;
+		LARGE_INTEGER start, end;
+		QueryPerformanceCounter(&start);
+		for (int i = 0; i < samples; ++i)
+		{
+			LARGE_INTEGER a, b;
+			QueryPerformanceCounter(&a);
+			QueryPerformanceCounter(&b);
+		}
+		QueryPerformanceCounter(&end);
+		const double freq = (double)zhLockFrequency();
+		pairUs = (double)(end.QuadPart - start.QuadPart) * 1000000.0 / (freq * (double)samples);
+	}
+	return pairUs;
+}
+
+// Times a whole critical-section scope: construct BEFORE the lock guard so the destructor runs
+// after the unlock (destruction is reverse order), giving enter + body + leave.
+class ZhLockTimer
+{
+public:
+	explicit ZhLockTimer(ZhLockTotals &totals) : m_totals(totals), m_start(0), m_started(false)
+	{
+		if (zhLockLogEnabled())
+		{
+			m_start = zhLockNow();
+			m_started = true;
+		}
+	}
+
+	~ZhLockTimer()
+	{
+		if (m_started)
+		{
+			++m_totals.calls;
+			m_totals.ticks += (unsigned long long)(zhLockNow() - m_start);
+		}
+	}
+
+private:
+	ZhLockTotals &m_totals;
+	long long m_start;
+	bool m_started;
+};
