 static Bool collideTest_Box_Box(const CollideInfo *a, const CollideInfo *b, CollideLocAndNormal *cinfo);
 
+// PROJECT PATCH (T-055): conservative bounding-sphere radius for the broadphase.
+// GeometryInfo::calcBoundingStuff() stores max(majorRadius, height/2) for cylinders, which is
+// smaller than the true half-diagonal sqrt(r^2 + (h/2)^2). Tall trees (r=3, h=15) therefore made
+// the broadphase reject real debris collisions. Use the true half-diagonal when it is larger;
+// boxes already store it, spheres are exact.
+static Real zhConservativeBoundingRadius(const GeometryInfo &g)
+{
+	Real radius = g.getBoundingSphereRadius();
+	if (g.getGeomType() == GEOMETRY_CYLINDER || g.getGeomType() == GEOMETRY_BOX)
+	{
+		const Real halfH = g.getMaxHeightAbovePosition() * 0.5f;
+		Real r2 = g.getMajorRadius() * g.getMajorRadius() + halfH * halfH;
+		if (g.getGeomType() == GEOMETRY_BOX)
+			r2 += g.getMinorRadius() * g.getMinorRadius();
+		const Real exact = (Real)sqrt((double)r2);
+		if (exact > radius)
+			radius = exact;
+	}
+	return radius;
+}
