+#include <algorithm>
+#include <array>
+#include <bit>
+#include <map>
+#include <vector>
+
+namespace formationOccupancy {
+
+struct Rect {
+    int left = 1, right = 0, bottom = 1, top = 0;
+    bool valid() const { return left <= right && bottom <= top; }
+    bool operator==(const Rect &) const = default;
+
+    void include(int x, int y, int radius)
+    {
+        if (!valid()) {
+            left = right = x;
+            bottom = top = y;
+        }
+        left = std::min(left, x - radius);
+        right = std::max(right, x + radius);
+        bottom = std::min(bottom, y - radius);
+        top = std::max(top, y + radius);
+    }
+};
+
+using Key = std::array<unsigned, 8>;
+
+struct Record {
+    unsigned frame = 0;
+    unsigned revision = 0;
+    Rect area;
