+// PROJECT PATCH (T-039): hybrid-GPU adapter selection.
+// The retail engine always renders on D3DADAPTER_DEFAULT, which on a hybrid laptop is usually
+// the integrated GPU. Pick the adapter with the most dedicated video memory reported by DXGI
+// so the discrete GPU is used by default. ZH_ADAPTER=<n> forces an index; ZH_ADAPTER_LOG=<path>
+// records the decision for benchmarks.
+static int Get_Preferred_Render_Device(IDirect3D8 *d3d)
+{
+	if (d3d == nullptr)
+		return 0;
+
+	const int adapterCount = d3d->GetAdapterCount();
+	if (adapterCount <= 1)
+		return 0;
+
+	if (const char *forced = static_cast<const char*>(nullptr))
+	{
+		const int index = atoi(forced);
+		if (index >= 0 && index < adapterCount)
+			return index;
+	}
+
+	struct DxgiAdapterInfo
+	{
+		unsigned vendor;
+		unsigned device;
+		unsigned long long dedicatedVideoMemory;
+		bool valid;
+	};
+	DxgiAdapterInfo dxgiAdapters[16] = {};
+	int dxgiAdapterCount = 0;
+
+	HMODULE dxgiLibrary = LoadLibraryA("dxgi.dll");
+	if (dxgiLibrary != nullptr)
+	{
+		typedef HRESULT (WINAPI *PFN_CreateDXGIFactory)(REFIID, void **);
+		PFN_CreateDXGIFactory createFactory = (PFN_CreateDXGIFactory)GetProcAddress(dxgiLibrary, "CreateDXGIFactory");
+		IDXGIFactory *factory = nullptr;
+		if (createFactory != nullptr && SUCCEEDED(createFactory(__uuidof(IDXGIFactory), (void **)&factory)) && factory != nullptr)
+		{
+			for (UINT i = 0; i < ARRAY_SIZE(dxgiAdapters); ++i)
+			{
+				IDXGIAdapter *adapter = nullptr;
+				if (factory->EnumAdapters(i, &adapter) != S_OK || adapter == nullptr)
+					break;
+
+				DXGI_ADAPTER_DESC desc;
+				::ZeroMemory(&desc, sizeof(desc));
+				if (SUCCEEDED(adapter->GetDesc(&desc)))
+				{
+					dxgiAdapters[dxgiAdapterCount].vendor = desc.VendorId;
+					dxgiAdapters[dxgiAdapterCount].device = desc.DeviceId;
+					dxgiAdapters[dxgiAdapterCount].dedicatedVideoMemory = desc.DedicatedVideoMemory;
+					dxgiAdapters[dxgiAdapterCount].valid = true;
+					++dxgiAdapterCount;
+				}
+				adapter->Release();
+			}
+			factory->Release();
+		}
+		FreeLibrary(dxgiLibrary);
+	}
+
+	int bestAdapter = 0;
+	unsigned long long bestScore = 0;
+	bool bestFound = false;
+	for (int adapterIndex = 0; adapterIndex < adapterCount; ++adapterIndex)
+	{
+		D3DADAPTER_IDENTIFIER8 identifier;
+		::ZeroMemory(&identifier, sizeof(identifier));
+		if (FAILED(d3d->GetAdapterIdentifier(adapterIndex, D3DENUM_NO_WHQL_LEVEL, &identifier)))
+			continue;
+
+		D3DCAPS8 caps;
+		::ZeroMemory(&caps, sizeof(caps));
+		if (FAILED(d3d->GetDeviceCaps(adapterIndex, WW3D_DEVTYPE, &caps)))
+			continue;
+
+		unsigned long long score = 1;
+		for (int i = 0; i < dxgiAdapterCount; ++i)
+		{
+			if (dxgiAdapters[i].valid &&
+				dxgiAdapters[i].vendor == identifier.VendorId &&
+				dxgiAdapters[i].device == identifier.DeviceId)
+			{
+				score = dxgiAdapters[i].dedicatedVideoMemory + 1;
+				break;
+			}
+		}
+
+		// Without DXGI, prefer any non-Intel hardware adapter over the integrated one.
+		if (dxgiAdapterCount == 0 && identifier.VendorId != 0x8086)
+			score = 2;
+
+		if (!bestFound || score > bestScore)
+		{
+			bestAdapter = adapterIndex;
+			bestScore = score;
+			bestFound = true;
+		}
+	}
+
+	if (const char *logPath = static_cast<const char*>(nullptr))
+	{
+		FILE *log = fopen(logPath, "a");
+		if (log != nullptr)
+		{
+			fprintf(log, "adapters=%d chosen=%d score=%llu\n", adapterCount, bestAdapter, bestScore);
+			for (int i = 0; i < adapterCount; ++i)
+			{
+				D3DADAPTER_IDENTIFIER8 identifier;
+				::ZeroMemory(&identifier, sizeof(identifier));
+				if (SUCCEEDED(d3d->GetAdapterIdentifier(i, D3DENUM_NO_WHQL_LEVEL, &identifier)))
+					fprintf(log, "  adapter[%d] vendor=0x%04X device=0x%04X desc=%s\n",
+						i, identifier.VendorId, identifier.DeviceId, identifier.Description);
+			}
+			fclose(log);
+		}
+	}
+
+	return bestAdapter;
+}
