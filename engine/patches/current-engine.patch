+extern unsigned g_zhAttrAwakeModules;
+extern unsigned g_zhAttrSleepyModules;
+
+// Per-call worst cases (only filled when ZH_ATTR_SAMPLE=1, because they add two QPC reads
+// per module and per destroyed object).
+extern double g_zhAttrSlowestUpdateMs;
+extern char g_zhAttrSlowestUpdate[64];
+extern char g_zhAttrSlowestUpdateObject[64];
+extern double g_zhAttrSlowestDestroyMs;
+extern char g_zhAttrSlowestDestroy[64];
+
+extern int g_zhAttrDestroyObjects;
+extern int g_zhAttrSpawnObjects;
