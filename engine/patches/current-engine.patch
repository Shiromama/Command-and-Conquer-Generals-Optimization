+Bool Pathfinder::hasPendingPath(const Object *obj) const
+{
+    return obj && frozenRouteShadow::hasPending(unsigned(obj->getID()));
+}
+
+void Pathfinder::applyBatch()
+{
+    if (!frozenRouteShadow::hasPendingObjects())
+        return;
+    for (unsigned id : frozenRouteShadow::pendingObjects()) {
+        Object *obj=TheGameLogic ? TheGameLogic->findObjectByID(ObjectID(id)) : nullptr;
+        AIUpdateInterface *ai=obj ? obj->getAIUpdateInterface() : nullptr;
+        if (!ai) {
+            frozenRouteShadow::dropPending(id);
+            continue;
+        }
+        Path *path=takePendingPath(obj);
+        if (path)
+            ai->applyBatchPath(path);
+        else
+            ai->serialBatchPath();
+    }
+}
+
+Path *Pathfinder::takePendingPath(const Object *obj)
+{
+    if (!obj)
+        return nullptr;
+    frozenRouteShadow::PendingResult pending;
+    if (frozenRouteShadow::takePending(unsigned(obj->getID()),pending)!=2)
+        return nullptr;
+    using namespace workerGroundSearch;
+    const auto &raw=pending.route.raw;
+    Path *path=newInstance(Path);
+    const std::size_t count=raw.size()>1?raw.size()-1:raw.size();
+    const std::size_t blockedCount=raw.size()>1?raw.size()-1:0;
+    bool blocked=false;
+    for (std::size_t i=0;i<blockedCount;++i)
+        blocked|=raw[i].blocked;
+    for (std::size_t i=0;i<count;++i) {
+        m_zoneManager.setPassable(raw[i].point.x,raw[i].point.y,true);
+        Coord3D point{};
+        adjustCoordToCell(raw[i].point.x,raw[i].point.y,pending.center,point,LAYER_GROUND);
+        path->prependNode(&point,LAYER_GROUND);
+        path->getFirstNode()->setCanOptimize(true);
+    }
+    const Coord3D *first=path->getFirstNode()->getPosition();
+    if (pending.from.x!=first->x || pending.from.y!=first->y)
+        path->prependNode(&pending.from,LAYER_GROUND);
+    m_zoneManager.setPassable(pending.startX,pending.startY,true);
+    if (blocked)
+        path->setBlockedByAlly(true);
+    path->optimize(obj,static_cast<LocomotorSurfaceTypeMask>(pending.surfaces),false);
+    m_cumulativeCellsAllocated+=int(pending.route.cleanupCount);
+    return path;
+}
