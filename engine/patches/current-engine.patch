+#pragma once
+
+#include <array>
+#include <cstdint>
+
+class GroupClearanceMemo
+{
+public:
+    class Scope
+    {
+    public:
+        Scope(GroupClearanceMemo &memo, bool enable)
+            : m_memo(memo), m_owns(enable && !memo.m_inScope)
+        {
+            // A reentrant search cannot reuse the enclosing search's view of occupancy.
+            if (memo.m_inScope)
+                memo.invalidate();
+            if (!m_owns)
+                return;
+
+            memo.m_inScope = true;
+            memo.m_active = true;
+            if (++memo.m_generation == 0)
+            {
+                for (Entry &entry : memo.m_entries)
+                    entry.generation = 0;
+                ++memo.m_generation;
+            }
+        }
+
+        Scope(const Scope &) = delete;
+        Scope &operator=(const Scope &) = delete;
+
+        ~Scope()
+        {
+            if (m_owns)
+            {
+                m_memo.invalidate();
+                m_memo.m_inScope = false;
+            }
+        }
+
+    private:
+        GroupClearanceMemo &m_memo;
+        bool m_owns;
+    };
+
+    void invalidate()
+    {
+        m_active = false;
+    }
+
+    template<class Compute>
+    int get(int x, int y, int layer, int diameter, bool crusher, Compute compute)
+    {
+        if (!m_active)
+            return compute();
+
+        const std::uint32_t hash = std::uint32_t(x) * 73856093u ^
+            std::uint32_t(y) * 19349663u ^ std::uint32_t(layer) * 83492791u ^
+            std::uint32_t(diameter) * 2654435761u ^ std::uint32_t(crusher);
+        Entry &entry = m_entries[hash & (m_entries.size() - 1)];
+        if (entry.generation == m_generation && entry.x == x && entry.y == y &&
+            entry.layer == layer && entry.diameter == diameter && entry.crusher == crusher)
+            return entry.result;
+
+        const int result = compute();
+        entry = {m_generation, x, y, layer, diameter, result, crusher};
+        return result;
+    }
+
+private:
+    struct Entry
+    {
+        std::uint32_t generation = 0;
+        int x, y, layer, diameter, result;
+        bool crusher;
+    };
+
+    std::array<Entry, 8192> m_entries;
+    std::uint32_t m_generation = 0;
+    bool m_active = false;
+    bool m_inScope = false;
+};
