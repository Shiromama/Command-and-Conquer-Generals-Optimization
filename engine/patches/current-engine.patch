+			g_zhAttrDisplayStringMs = ms;
+		else if (strcmp(name, "shell") == 0)
+			g_zhAttrShellMs = ms;
+		else if (strcmp(name, "ingameui") == 0)
+			g_zhAttrIngameUiMs = ms;
+		if (phaseFile != nullptr)
+		{
