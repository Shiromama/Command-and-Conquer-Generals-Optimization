+	if (s_zhCalibFile == nullptr || (s_zhAttrRow % 100) != 0)
+		return;
+	LARGE_INTEGER calibStart, calibEnd;
+	QueryPerformanceCounter(&calibStart);
+	volatile unsigned long long acc = 88172645463325252ull;
+	for (unsigned i = 0; i < 2000000u; ++i)
+		acc = acc * 6364136223846793005ull + 1442695040888963407ull;
+	QueryPerformanceCounter(&calibEnd);
+	fprintf(s_zhCalibFile, "%llu,%d,%.1f\n", s_zhAttrRow,
