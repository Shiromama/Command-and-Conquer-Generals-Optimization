+namespace frozenRouteShadow {
+using namespace workerGroundSearch;
+using Pages = nativePageSnapshot::Grid::Snapshot;
+using Input = FrozenGroundInput<Pages>;
+using Clock = std::chrono::steady_clock;
+
+struct Reply {
+    std::optional<Result> route;
+    double usec;
+    std::vector<std::size_t> pagesRead;
+};
+
+Reply solve(const std::shared_ptr<const Input> &input)
+{
+    static thread_local Workspace workspace;
+    const auto started = Clock::now();
+    FrozenGroundAccess<Pages,footprintShadow::retailGenerals,footprintShadow::infantryPasses> access(*input);
+    auto result = workspace.run(input->query,access);
+    return {std::move(result),earlyQueueProbe::micros(started),std::move(access.reads)};
+}
+
+using Pool=SpeculativeWorkers<std::shared_ptr<const Input>,Reply,decltype(&solve)>;
+struct Reference {
+    std::vector<Step> chain;
+    unsigned expansions = 0, cleanup = 0;
+    unsigned cost = 0;
+    double nativeUsec = 0;
+    bool available = false, readyAtOriginal = false;
+};
+
+struct Flight {
+    std::optional<Pool::Ticket> ticket;
+    Reference legacy;
+    std::shared_ptr<const Pages> pages;
+    Clock::time_point nativeStarted;
+    unsigned tick = 0, id = 0;
+};
+
+static std::optional<Pool> pool;
+static std::array<Flight,8> flights;
+static std::uint32_t submittedThisTick = 0, lastTick = 0;
+
+// T-127: deferred ordinary-path commit store, keyed by object ID.
+struct Pending {
+    std::size_t lane = 0;
+    Pool::Ticket ticket{};
+    unsigned tick = 0;
+    std::shared_ptr<const Pages> pages;
+    Coord3D from{};
+    bool center = false;
+    unsigned surfaces = 0;
+    int startX = 0, startY = 0;
+};
+struct PendingResult {
+    Result route;
+    Coord3D from{};
+    bool center = false;
+    unsigned surfaces = 0;
+    int startX = 0, startY = 0;
+};
+static std::unordered_map<unsigned,Pending> pendingByObject;
+
+FILE *log()
+{
+    static FILE *file = []() -> FILE * {
+        const char *name = std::getenv("ZH_FROZEN_ROUTE_SHADOW");
+        FILE *log = name ? std::fopen(name,"w") : nullptr;
+        if (log)
+            std::fputs("stage,tick,lane,actor,state,usec,units,pages,match,ready\n",log);
+        return log;
+    }();
+    return file;
+}
+
+void drain(unsigned now)
+{
+    if (!pool)
+        return;
+    for (auto &flight : flights) {
+        if (!flight.ticket || !flight.legacy.available)
+            continue;
+        const auto ticket=*flight.ticket;
+        if (!pool->ready(ticket) && now-flight.tick < 3)
+            continue;
+        const auto started=Clock::now();
+        auto reply=pool->take(ticket,[](const Reply &) { return true; });
+        const double claim=earlyQueueProbe::micros(started);
+        const auto verifyStarted=Clock::now();
+        const bool pagesMatch=reply && nativePageSnapshot::live &&
+            nativePageSnapshot::live->validate(*flight.pages,reply->pagesRead);
+        const double pageValidation=earlyQueueProbe::micros(verifyStarted);
+        const Reference &legacy=flight.legacy;
+        const auto *route=reply && reply->route ? &*reply->route : nullptr;
+        const bool match=route && route->raw==legacy.chain && route->goalCost==legacy.cost &&
+            route->expansions==legacy.expansions && route->cleanupCount==legacy.cleanup;
+        std::fprintf(log(),"C,%u,%zu,%u,%s,%.3f,0,%zu,%d,%u\n",flight.tick,ticket.lane,flight.id,
+            route ? "compared" : reply ? "unsupported" : "unfinished",claim,
+            reply ? reply->pagesRead.size() : 0,route ? int(match) : -1,unsigned(legacy.readyAtOriginal));
+        if (route)
+            std::fprintf(log(),"L,%u,%zu,%u,%d,%d,%u,%u\n",flight.tick,ticket.lane,flight.id,
+                int(route->raw==legacy.chain),int(route->goalCost==legacy.cost),
+                route->expansions,legacy.expansions);
+        if (reply)
+            std::fprintf(log(),"V,%u,%zu,%u,pages,%.3f,0,%zu,%u,-1\n",
+                flight.tick,ticket.lane,flight.id,pageValidation,reply->pagesRead.size(),unsigned(pagesMatch));
+        std::fprintf(log(),"R,%u,%zu,%u,original,%.3f,0,0,-1,-1\n",
+            flight.tick,ticket.lane,flight.id,legacy.nativeUsec);
+        if (reply)
+            std::fprintf(log(),"W,%u,%zu,%u,solved,%.3f,0,0,-1,-1\n",
+                flight.tick,ticket.lane,flight.id,reply->usec);
+        std::fflush(log());
+        pendingByObject.erase(flight.id);
+        flight={};
+    }
+}
+
+std::shared_ptr<const std::vector<UnitFacts>> unitsNow(const Object *actor)
+{
+    auto units=std::make_shared<std::vector<UnitFacts>>();
+    for (Object *other=TheGameLogic->getFirstObject();other;other=other->getNextObject()) {
+        const auto *ai=other->getAIUpdateInterface();
+        const auto relation=actor->getRelationship(other);
+        const bool squash=relation!=ALLIES && actor->canCrushOrSquish(other,TEST_CRUSH_OR_SQUISH);
+        // Same facts as footprintShadow::facts(actor,id), but the object is
+        // already in hand, so the redundant findObjectByID lookup is gone.
+        units->push_back({{footprintPolicy::Id(other->getID()),true,relation==ALLIES,ai!=nullptr,
+            ai && bool(ai->isIdle()),bool(other->isKindOf(KINDOF_INFANTRY))},
+            relation==ENEMIES,squash});
+    }
+    std::sort(units->begin(),units->end(),[](const UnitFacts &a,const UnitFacts &b) {
+        return a.unit.id<b.unit.id;
+    });
+    return units;
+}
+
+template<class CaptureResident,class CaptureZone>
+int submit(unsigned tick,const Object *actor,Input input,CaptureResident resident,CaptureZone zones)
+{
+    if (!log())
+        return -1;
+    std::fprintf(log(),"G,%u,%d,%d,%d,%d\n",tick,int(bool(nativePageSnapshot::live)),
+        input.query.grid.left,input.query.grid.top,input.query.grid.right);
+    std::fflush(log());
+    if (!nativePageSnapshot::live || tick < 16978 || tick > 17277 ||
+        input.query.grid.left || input.query.grid.top)
+        return -1;
+    if (!pool)
+        pool.emplace(&solve);
+    if (lastTick != tick) {
+        submittedThisTick=0;
+        lastTick=tick;
+        drain(tick);
+    }
+    // A diagnostic capacity limit keeps the replay runnable while comparing
+    // the worker to the original solver on the same physical machine.
+    if (submittedThisTick==8)
+        return -1;
+    for (std::size_t lane=0; lane<flights.size(); ++lane) {
+        if (flights[lane].ticket)
+            continue;
+        const auto started=Clock::now();
+        const auto grid=input.query.grid;
+        input.pages=std::make_shared<const Pages>(nativePageSnapshot::live->freeze());
+        // resident only gates new-record accounting (freeRecords); the route is
+        // independent. A conservative all-new grid avoids the 65k per-search copy.
+        static std::shared_ptr<const std::vector<std::uint8_t>> emptyResident;
+        static std::size_t emptyResidentSize=0;
+        const std::size_t residentNeed=std::size_t(grid.right)*grid.bottom;
+        if (emptyResidentSize!=residentNeed) {
+            emptyResident=std::make_shared<std::vector<std::uint8_t>>(residentNeed,0);
+            emptyResidentSize=residentNeed;
+        }
+        input.resident=emptyResident;
+        input.zoneWidth=(grid.right+9)/10;
+        auto passableCells=std::make_shared<std::vector<std::uint8_t>>();
+        for (int y=0;y<grid.bottom;y+=10)
+            for (int x=0;x<grid.right;x+=10)
+                passableCells->push_back(zones(x,y));
+        input.passable=passableCells;
+        input.units=unitsNow(actor);
+        auto job=std::make_shared<const Input>(std::move(input));
+        const auto ticket=pool->offer(lane,job);
+        std::fprintf(log(),"B,%u,%zu,%u,%s,%.3f,%zu,0,-1,-1\n",tick,lane,unsigned(actor->getID()),
+            ticket ? "submitted" : "busy",earlyQueueProbe::micros(started),job->units->size());
+        std::fflush(log());
+        if (!ticket)
+            return -1;
+        ++submittedThisTick;
+        flights[lane]={ticket,{},job->pages,Clock::now(),tick,unsigned(actor->getID())};
+        return int(lane);
+    }
+    return -1;
+}
+
+std::optional<Reply> takeCommit(int lane)
+{
+    if (!pool || lane<0 || std::size_t(lane)>=flights.size())
+        return std::nullopt;
+    auto &flight=flights[lane];
+    if (!flight.ticket)
+        return std::nullopt;
+    const auto ticket=*flight.ticket;
+    const auto pages=flight.pages;
+    const auto deadline=Clock::now()+std::chrono::microseconds(400);
+    while (Clock::now()<deadline) {
+        if (pool->ready(ticket)) {
+            auto reply=pool->take(ticket,[&](const Reply &result) {
+                return nativePageSnapshot::live && pages &&
+                    nativePageSnapshot::live->validate(*pages,result.pagesRead);
+            });
+            flight={};
+            return reply;
+        }
+        std::this_thread::yield();
+    }
+    return std::nullopt;
+}
+
+template<class CaptureZone>
+bool submitPending(unsigned tick,const Object *actor,Input input,const Coord3D &from,bool center,
+                   unsigned surfaces,int startX,int startY,CaptureZone zones)
+{
+    if (!nativePageSnapshot::live || !actor)
+        return false;
+    if (!pool)
+        pool.emplace(&solve);
+    if (lastTick != tick) {
+        submittedThisTick=0;
+        lastTick=tick;
+        drain(tick);
+    }
+    if (submittedThisTick>=8)
+        return false;
+    for (std::size_t lane=0; lane<flights.size(); ++lane) {
+        if (flights[lane].ticket)
+            continue;
+        const auto grid=input.query.grid;
+        input.pages=std::make_shared<const Pages>(nativePageSnapshot::live->freeze());
+        static std::shared_ptr<const std::vector<std::uint8_t>> emptyResident;
+        static std::size_t emptyResidentSize=0;
+        const std::size_t need=std::size_t(grid.right)*grid.bottom;
+        if (emptyResidentSize!=need) {
+            emptyResident=std::make_shared<std::vector<std::uint8_t>>(need,0);
+            emptyResidentSize=need;
+        }
+        input.resident=emptyResident;
+        input.zoneWidth=(grid.right+9)/10;
+        auto passable=std::make_shared<std::vector<std::uint8_t>>();
+        for (int y=0;y<grid.bottom;y+=10)
+            for (int x=0;x<grid.right;x+=10)
+                passable->push_back(zones(x,y));
+        input.passable=passable;
+        input.units=unitsNow(actor);
+        auto job=std::make_shared<const Input>(std::move(input));
+        const auto ticket=pool->offer(lane,job);
+        if (!ticket)
+            continue;
+        ++submittedThisTick;
+        flights[lane]={ticket,{},job->pages,Clock::now(),tick,unsigned(actor->getID())};
+        pendingByObject[unsigned(actor->getID())]={lane,*ticket,tick,job->pages,from,center,surfaces,startX,startY};
+        return true;
+    }
+    return false;
+}
+
+bool hasPending(unsigned id)
+{
+    return pendingByObject.find(id)!=pendingByObject.end();
+}
+
+bool hasPendingObjects()
+{
+    return !pendingByObject.empty();
+}
+
+std::vector<unsigned> pendingObjects()
+{
+    std::vector<unsigned> ids;
+    ids.reserve(pendingByObject.size());
+    for (const auto &entry : pendingByObject)
+        ids.push_back(entry.first);
+    return ids;
+}
+
+void dropPending(unsigned id)
+{
+    pendingByObject.erase(id);
+}
+
+// 2 = ready result, 1 = none, 0 = missed/invalid (serial fallback).
+int takePending(unsigned id,PendingResult &out)
+{
+    auto it=pendingByObject.find(id);
+    if (it==pendingByObject.end())
+        return 1;
+    Pending pending=it->second;
+    pendingByObject.erase(it);
+    if (!pool || !nativePageSnapshot::live || !pending.pages)
+        return 0;
+    if (!pool->ready(pending.ticket))
+        return 0;
+    auto reply=pool->take(pending.ticket,[&](const Reply &result) {
+        return nativePageSnapshot::live && nativePageSnapshot::live->validate(*pending.pages,result.pagesRead);
+    });
+    if (pending.lane<flights.size() && flights[pending.lane].ticket)
+        flights[pending.lane]={};
+    if (!reply || !reply->route)
+        return 0;
+    out.route=*reply->route;
+    out.from=pending.from;
+    out.center=pending.center;
+    out.surfaces=pending.surfaces;
+    out.startX=pending.startX;
+    out.startY=pending.startY;
+    return 2;
+}
+
+void capture(int lane,const PathfindCell *goal)
+{
+    if (lane < 0)
+        return;
+    auto &reference=flights[lane].legacy;
+    reference.cost=goal ? goal->getCostSoFar() : 0;
+    for (const auto *cell=goal;cell && cell->hasInfo();cell=cell->getParentCell()) {
+        if (reference.chain.size()==30000)
+            break;
+        reference.chain.push_back({{cell->getXIndex(),cell->getYIndex()},bool(cell->isBlockedByAlly())});
+    }
+}
+
+void finish(int lane,unsigned expansions,unsigned cleanup)
+{
+    if (lane<0)
+        return;
+    auto &flight=flights[lane];
+    flight.legacy.nativeUsec=earlyQueueProbe::micros(flight.nativeStarted);
+    flight.legacy.expansions=expansions;
+    flight.legacy.cleanup=cleanup;
+    flight.legacy.available=true;
+    flight.legacy.readyAtOriginal=pool->ready(*flight.ticket);
+    drain(TheGameLogic->getFrame());
+}
+}
