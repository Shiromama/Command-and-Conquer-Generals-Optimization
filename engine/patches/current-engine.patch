+// T-022: singleplayer-only deterministic movement workload, included by GameLogic.cpp.
+#include "Common/OptimizationPolicy.h"
+static int zhPfInt(const char *key, int fallback, int low, int high) {
+    const char *p=getenv(key); int v=p?atoi(p):fallback;
+    return v<low?low:(v>high?high:v);
+}
+static void zhPfCompleteObject(Object *obj) {
+    for(BehaviorModule **module=obj->getBehaviorModules();*module;++module) {
+        CreateModuleInterface *create=(*module)->getCreate(); if(create)create->onBuildComplete();
+    }
+    TheAI->pathfinder()->addObjectToPathfindMap(obj);
+}
+static void zhPathfindHarness(GameLogic *logic) {
+    static std::vector<ObjectID> units, blockers;
+    static unsigned lastFrame=0, startFrame=0, wave=0, seed=1;
+    static bool spawned=false;
+    static Coord3D center{},choke{};
+    const bool permitted=zh::experimentalSimulationAllowed(
+        zh::parseBoolean(static_cast<const char*>(nullptr),false),
+        logic->isInMultiplayerGame(),logic->isInReplayGame());
+    if(!logic->isInGame() || logic->isInShellGame() || !permitted || logic->getFrame()<lastFrame) {
+        units.clear(); blockers.clear(); spawned=false; wave=0;
+    }
+    lastFrame=logic->getFrame();
+    if(!permitted || !logic->isInGame() || logic->isInShellGame() || !static_cast<const char*>(nullptr)) return;
+    const int groups=zhPfInt("ZH_PF_GROUPS",8,0,32), size=zhPfInt("ZH_PF_GROUP_SIZE",25,1,50);
+    if(!groups) return;
+    const unsigned interval=zhPfInt("ZH_PF_INTERVAL",90,1,3600);
+    if(!spawned) {
+        Player *player=ThePlayerList?ThePlayerList->getLocalPlayer():nullptr;
+        Team *team=player?player->getDefaultTeam():nullptr;
+        const ThingTemplate *mobile=TheThingFactory->findTemplate("AmericaTankCrusader");
+        const ThingTemplate *building=TheThingFactory->findTemplate("AmericaPowerPlant");
+        if(!team || !mobile || !building || !TheTacticalView) return;
+        Region3D extent;
+        TheTerrainLogic->getExtent(&extent);
+        center.x=(extent.lo.x+extent.hi.x)*0.5f;
+        center.y=(extent.lo.y+extent.hi.y)*0.5f;
+        center.z=TheTerrainLogic->getGroundHeight(center.x,center.y);
+        choke=center; choke.y+=120.0f;
+        TheTacticalView->lookAt(&center);
+        const char *spawnPath=static_cast<const char*>(nullptr);
+        FILE *spawnLog=spawnPath&&*spawnPath?fopen(spawnPath,"w"):nullptr;
+        if(spawnLog) fprintf(spawnLog,"kind,object,x,y,loX,loY,hiX,hiY,adjusted\n");
+        seed=static_cast<unsigned>(zhPfInt("ZH_PF_SEED",1,0,2147483647));
+        const int count=zhPfInt("ZH_PF_BLOCKERS",0,0,16);
+        for(int i=0;i<count;++i) {
+            Coord3D p=center; p.y+=(i-(count-1)*0.5f)*100.0f;
+            p.z=TheTerrainLogic->getGroundHeight(p.x,p.y);
+            Object *obj=TheThingFactory->newObject(building,team);
+            if(obj) {
+                obj->setPosition(&p); zhPfCompleteObject(obj); blockers.push_back(obj->getID());
+                if(spawnLog) fprintf(spawnLog,"blocker,%u,%.9g,%.9g,%.9g,%.9g,%.9g,%.9g,0\n",obj->getID(),p.x,p.y,extent.lo.x,extent.lo.y,extent.hi.x,extent.hi.y);
+            }
+        }
+        // With at least two blockers the convergence point is the actual wall opening,
+        // rather than an arbitrary camera/map point. Log the gap dimensions and path-cell state.
+        if(blockers.size()>=2) {
+            const unsigned low=(static_cast<unsigned>(blockers.size())-1)/2;
+            Object *a=logic->findObjectByID(blockers[low]);
+            Object *b=logic->findObjectByID(blockers[low+1]);
+            if(a&&b) { choke=*a->getPosition();choke.y=(a->getPosition()->y+b->getPosition()->y)*0.5f; }
+        }
+        for(int g=0;g<groups;++g) for(int j=0;j<size;++j) {
+            Coord3D p=center;
+            p.x+=(g%2?-1.0f:1.0f)*(300.0f+(j%5)*25.0f);
+            p.y+=(g/2-(groups/2-1)*0.5f)*150.0f+(j/5-2)*25.0f;
+            p.z=TheTerrainLogic->getGroundHeight(p.x,p.y);
+            Object *obj=TheThingFactory->newObject(mobile,team);
+            if(obj) {
+                obj->setPosition(&p);
+                zhPfCompleteObject(obj);
+                bool adjusted=false;
+                if(obj->getAIUpdateInterface()) {
+                    const Coord3D desired=p;
+                    for(int attempt=0;attempt<121 && !adjusted;++attempt) {
+                        p=desired;
+                        if(attempt) {
+                            p.x+=(attempt%11-5)*60.0f;
+                            p.y+=(attempt/11-5)*60.0f;
+                        }
+                        if(p.x<extent.lo.x+30 || p.y<extent.lo.y+30 || p.x>extent.hi.x-30 || p.y>extent.hi.y-30) continue;
+                        adjusted=TheAI->pathfinder()->adjustDestination(obj,obj->getAIUpdateInterface()->getLocomotorSet(),&p);
+                    }
+                }
+                if(adjusted) TheAI->pathfinder()->updateGoal(obj,&p,LAYER_GROUND);
+                p.z=TheTerrainLogic->getGroundHeight(p.x,p.y); obj->setPosition(&p);
+                units.push_back(obj->getID());
+                if(spawnLog) fprintf(spawnLog,"unit,%u,%.9g,%.9g,%.9g,%.9g,%.9g,%.9g,%u\n",obj->getID(),p.x,p.y,extent.lo.x,extent.lo.y,extent.hi.x,extent.hi.y,adjusted);
+            }
+        }
+        if(spawnLog) fclose(spawnLog);
+        const char *fixturePath=static_cast<const char*>(nullptr);
+        FILE *fixture=fixturePath&&*fixturePath?fopen(fixturePath,"w"):nullptr;
+        if(fixture) {
+            Object *unit=units.empty()?nullptr:logic->findObjectByID(units[0]);
+            Object *blocker=blockers.empty()?nullptr:logic->findObjectByID(blockers[blockers.size()/2]);
+            bool chokePassable=false,buildingPassable=true;
+            if(unit&&unit->getAIUpdateInterface()) {
+                const LocomotorSet &loco=unit->getAIUpdateInterface()->getLocomotorSet();
+                chokePassable=TheAI->pathfinder()->validMovementPosition(false,LAYER_GROUND,loco,&choke);
+                if(blocker) buildingPassable=TheAI->pathfinder()->validMovementPosition(false,LAYER_GROUND,loco,blocker->getPosition());
+            }
+            const GeometryInfo &geometry=building->getTemplateGeometryInfo();
+            fprintf(fixture,"blockers,chokeX,chokeY,chokePassable,buildingPassable,buildingMajor,buildingMinor,spacing\n");
+            fprintf(fixture,"%u,%.9g,%.9g,%u,%u,%.9g,%.9g,100\n",static_cast<unsigned>(blockers.size()),choke.x,choke.y,chokePassable,buildingPassable,geometry.getMajorRadius(),geometry.getMinorRadius());
+            fclose(fixture);
+        }
+        spawned=true; startFrame=logic->getFrame(); wave=0;
+    }
+    if((logic->getFrame()-startFrame)%interval) return;
+    const char *p=static_cast<const char*>(nullptr);
+    FILE *log=p&&*p?fopen(p,wave?"a":"w"):nullptr;
+    if(log && !wave) fprintf(log,"frame,wave,phase,object,fromX,fromY,toX,toY\n");
+    for(unsigned i=0;i<units.size();++i) {
+        Object *obj=logic->findObjectByID(units[i]);
+        if(!obj || obj->isEffectivelyDead() || !obj->getAIUpdateInterface()) continue;
+        Coord3D target=center;
+        const unsigned phase=wave%4;
+        // Local PRNG never consumes the simulation RNG; all commands follow object creation order.
+        seed=seed*1664525u+1013904223u;
+        const Real jitter=static_cast<Real>((seed>>16)%21)-10.0f;
+        const int g=i/size;
+        if(phase==0) { target.x+=(g%2?1.0f:-1.0f)*350.0f; target.y+=(g/2-(groups/2-1)*0.5f)*150.0f+jitter; }
+        if(phase==1) { target=choke; target.x+=jitter; }
+        if(phase==2 && !blockers.empty()) {
+            Object *b=logic->findObjectByID(blockers[blockers.size()/2]); if(b) target=*b->getPosition();
+        } else if(phase==2) { target.x+=jitter; }
+        if(phase==3) {
+            Object *b=logic->findObjectByID(units[(i+size)%units.size()]);
+            if(b) target=*b->getPosition();
+        }
