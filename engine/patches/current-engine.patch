+		g_zhAttrIngameUiMs,
+		g_zhAttrLogicUpdatesMs, g_zhAttrLogicAiMs, g_zhAttrLogicBuildMs,
+		g_zhAttrLogicPartitionMs, g_zhAttrLogicDestroyMs, g_zhAttrLogicRestMs,
+		g_zhAttrSlowestUpdateMs * 1000.0, g_zhAttrSlowestUpdate, g_zhAttrSlowestUpdateObject,
+		g_zhAttrDestroyObjects, g_zhAttrSlowestDestroyMs * 1000.0, g_zhAttrSlowestDestroy,
+		g_zhAttrSpawnObjects, g_zhAttrSpawnMs, g_zhAttrNukeTicks,
