+// PROJECT PATCH (T-036): test-only logic phase timing (ZH_PERF_LOGIC=<csv>).
+// Separates object updates, AI, build assistant, partition manager, destroy processing and the
+// remaining tail so a wreck-field slowdown can be attributed without a full profiler.
+static FILE *s_zhLogicLog = nullptr;
+static Bool s_zhLogicInit = FALSE;
+static LARGE_INTEGER s_zhLogicFreq;
+static void zhLogicMark(LARGE_INTEGER *t) { if (s_zhLogicLog != nullptr || zhAttrLogging()) QueryPerformanceCounter(t); }
+
+// PROJECT PATCH (T-051): record the slowest update module of the frame (opt-in, ZH_ATTR_SAMPLE=1).
+struct ZhAttrModuleTotal {
+	unsigned key = 0;
+	double ms = 0.0;
+};
+static ZhAttrModuleTotal s_zhAttrModuleTotals[256];
+static bool s_zhAttrModuleUsed[256];
+static void zhAttrNoteUpdate(const UpdateModule *u, double ms)
+{
+	// T-127: fixed-slot histogram keyed by module name key; no per-update string
+	// or map allocation. Names are resolved only in the periodic report.
+	const unsigned key=unsigned(u->getModuleNameKey());
+	unsigned slot=key & 255u;
+	for (unsigned probe=0;probe<256;++probe,slot=(slot+1)&255u) {
+		if (!s_zhAttrModuleUsed[slot]) {
+			s_zhAttrModuleUsed[slot]=true;
+			s_zhAttrModuleTotals[slot].key=key;
+			s_zhAttrModuleTotals[slot].ms=ms;
+			break;
+		}
+		if (s_zhAttrModuleTotals[slot].key==key) {
+			s_zhAttrModuleTotals[slot].ms+=ms;
+			break;
+		}
+	}
+	if (ms <= g_zhAttrSlowestUpdateMs)
+		return;
+	g_zhAttrSlowestUpdateMs = ms;
+	const AsciiString mod = KEYNAME(u->getModuleNameKey());
+	strncpy(g_zhAttrSlowestUpdate, mod.str(), sizeof(g_zhAttrSlowestUpdate) - 1);
+	g_zhAttrSlowestUpdate[sizeof(g_zhAttrSlowestUpdate) - 1] = 0;
+	const Object *obj = u->friend_getObject();
+	if (obj != nullptr && obj->getTemplate() != nullptr)
+	{
+		strncpy(g_zhAttrSlowestUpdateObject, obj->getTemplate()->getName().str(), sizeof(g_zhAttrSlowestUpdateObject) - 1);
+		g_zhAttrSlowestUpdateObject[sizeof(g_zhAttrSlowestUpdateObject) - 1] = 0;
+	}
+}
+struct ZhAttrTeamAction {
+	const void *script = nullptr;
+	char name[96] = {0};
+	double ms = 0.0;
+};
+static ZhAttrTeamAction s_zhAttrTeamActions[64];
+void zhAttrNoteTeamAction(const void *script, const char *name, double ms)
+{
+	size_t key = (size_t)script;
+	unsigned slot = unsigned((key >> 4) & 63u);
+	for (unsigned probe = 0; probe < 64; ++probe, slot = (slot + 1) & 63u) {
+		ZhAttrTeamAction &entry = s_zhAttrTeamActions[slot];
+		if (!entry.script) {
+			entry.script = script;
+			if (name)
+				strncpy(entry.name, name, sizeof(entry.name) - 1);
+			entry.ms = ms;
+			return;
+		}
+		if (entry.script == script) {
+			entry.ms += ms;
+			return;
+		}
+	}
+}
+void zhAttrModuleReport(unsigned frame)
+{
+	static FILE *file=[]() -> FILE* {
+		const char *path=std::getenv("ZH_ATTR_MODULE_LOG");
+		FILE *f=path?std::fopen(path,"w"):nullptr;
+		if (f)
+			std::fputs("frame,module,ms\n",f);
+		return f;
+	}();
+	if (!file)
+		return;
+	std::vector<ZhAttrModuleTotal> rows;
+	for (unsigned i=0;i<256;++i)
+		if (s_zhAttrModuleUsed[i])
+			rows.push_back(s_zhAttrModuleTotals[i]);
+	std::sort(rows.begin(),rows.end(),[](const ZhAttrModuleTotal &a,const ZhAttrModuleTotal &b) {
+		return a.ms>b.ms;
+	});
+	for (std::size_t i=0;i<rows.size() && i<20;++i)
+		std::fprintf(file,"%u,%s,%.3f\n",frame,KEYNAME(NameKeyType(rows[i].key)).str(),rows[i].ms);
+	std::fprintf(file,"%u,AIUpdateInterface/state,%.3f\n",frame,g_zhAttrAiStateMs);
+	std::fprintf(file,"%u,AIUpdateInterface/book,%.3f\n",frame,g_zhAttrAiBookMs);
+	std::fprintf(file,"%u,AIUpdateInterface/turret,%.3f\n",frame,g_zhAttrAiTurretMs);
+	std::fprintf(file,"%u,AIUpdateInterface/locomotor,%.3f\n",frame,g_zhAttrAiLocomotorMs);
+	for (int i=0;i<ZH_ATTR_AI_STATE_SLOTS;++i)
+		if (g_zhAttrAiStateHist[i] > 0.0)
+			std::fprintf(file,"%u,AIState/%d,%.3f\n",frame,i,g_zhAttrAiStateHist[i]);
+	std::fprintf(file,"%u,AIScan/hunt,%.3f\n",frame,g_zhAttrHuntScanMs);
+	std::fprintf(file,"%u,AIScan/idle,%.3f\n",frame,g_zhAttrIdleScanMs);
+	std::fprintf(file,"%u,AIScan/guard,%.3f\n",frame,g_zhAttrGuardScanMs);
+	for (int i=0;i<ZH_ATTR_GUARD_SUB_SLOTS;++i)
+		if (g_zhAttrGuardSubHist[i] > 0.0)
+			std::fprintf(file,"%u,GuardSub/%d,%.3f\n",frame,5000+i,g_zhAttrGuardSubHist[i]);
+	for (int i=0;i<ZH_ATTR_AI_STATE_SLOTS;++i)
+		if (g_zhAttrHuntSubHist[i] > 0.0)
+			std::fprintf(file,"%u,HuntSub/%d,%.3f\n",frame,i,g_zhAttrHuntSubHist[i]);
+	std::vector<ZhAttrTeamAction> actions;
+	for (unsigned i=0;i<64;++i)
+		if (s_zhAttrTeamActions[i].script)
+			actions.push_back(s_zhAttrTeamActions[i]);
+	std::sort(actions.begin(),actions.end(),[](const ZhAttrTeamAction &a,const ZhAttrTeamAction &b) {
+		return a.ms>b.ms;
+	});
+	for (std::size_t i=0;i<actions.size() && i<64;++i)
+		std::fprintf(file,"%u,TeamAction/%s,%.3f\n",frame,actions[i].name?actions[i].name:"?",actions[i].ms);
+	std::fflush(file);
+}
+static double zhLogicMs(const LARGE_INTEGER &a, const LARGE_INTEGER &b)
+{
+	return (double)(b.QuadPart - a.QuadPart) * 1000.0 / (double)s_zhLogicFreq.QuadPart;
+}
