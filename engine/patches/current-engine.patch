+namespace {
+class ZhRenderThread
+{
+public:
+    ZhRenderThread()
+    {
+        const char *value=std::getenv("ZH_RENDER_THREAD");
+        m_enabled=value && value[0]=='1' && value[1]=='\0';
+        if (!m_enabled)
+            return;
+        const char *work=std::getenv("ZH_RENDER_WORK_US");
+        m_workUs=work ? std::strtoull(work,nullptr,10) : 0;
+        const char *device=std::getenv("ZH_RENDER_DEVICE");
+        m_device=device && device[0]=='1' && device[1]=='\0';
+        std::fprintf(stderr,"RT: ctor enabled work=%llu device=%d\n",m_workUs,m_device?1:0);
+        m_worker=std::thread([this] { run(); });
+        std::fprintf(stderr,"RT: thread created\n");
+    }
+    ~ZhRenderThread()
+    {
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_stop=true;
+        }
+        m_cv.notify_all();
+        if (m_worker.joinable())
+            m_worker.join();
+    }
+    bool enabled() const { return m_enabled; }
+    void submit()
+    {
+        if (!m_enabled)
+            return;
+        static int logged=0;
+        if (logged < 5) {
+            ++logged;
+            std::fprintf(stderr,"RT: submit %d\n",logged);
+        }
+        std::unique_lock<std::mutex> lock(m_mutex);
+        m_cv.wait(lock, [this] { return m_stop || m_pending < 2; });
+        if (m_stop)
+            return;
+        ++m_pending;
+        m_cv.notify_all();
+    }
+    void waitIdle()
+    {
+        if (!m_enabled)
+            return;
+        std::unique_lock<std::mutex> lock(m_mutex);
+        m_cv.wait(lock, [this] { return m_pending == 0 && m_active == 0; });
+    }
+private:
+    void run()
+    {
+        std::fprintf(stderr,"RT: worker start\n");
+        std::unique_lock<std::mutex> lock(m_mutex);
+        for (;;) {
+            m_cv.wait(lock, [this] { return m_stop || m_pending > 0; });
+            if (m_stop && m_pending == 0)
+                break;
+            --m_pending;
+            ++m_active;
+            m_cv.notify_all();
+            lock.unlock();
+            if (m_device)
+                TheDisplay->DRAW();
+            else
+                busyWait();
+            lock.lock();
+            --m_active;
+            m_cv.notify_all();
+        }
+    }
+    void busyWait()
+    {
+        if (m_workUs == 0)
+            return;
+        // T-127: model a present-bound draw (sleep) rather than a CPU spin; the
+        // spin starved the game's main thread in the handshake test. CPU-draw
+        // contention is measured separately before the real device-thread work.
+        std::this_thread::sleep_for(std::chrono::microseconds(m_workUs));
+    }
+    bool m_enabled=false;
+    bool m_device=false;
+    unsigned long long m_workUs=0;
+    std::thread m_worker;
+    std::mutex m_mutex;
+    std::condition_variable m_cv;
+    unsigned m_pending=0;
+    unsigned m_active=0;
+    bool m_stop=false;
+};
+ZhRenderThread &zhRenderThread()
+{
+    static ZhRenderThread thread;
+    return thread;
+}
