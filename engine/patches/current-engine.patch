diff --git a/Core/GameEngine/Source/GameLogic/AI/GroupRouteShadow.inc b/Core/GameEngine/Source/GameLogic/AI/GroupRouteShadow.inc
new file mode 100644
index 0000000..721a449
--- /dev/null
+++ b/Core/GameEngine/Source/GameLogic/AI/GroupRouteShadow.inc
@@ -0,0 +1,529 @@
+#include <algorithm>
+#include <bit>
+#include <cstdint>
+#include <cmath>
+#include <cstdlib>
+#include <functional>
+#include <limits>
+#include <queue>
+#include <string_view>
+#include <tuple>
+#include <utility>
+#include <vector>
+
+// Diagnostic only. No engine state or original route is written by this probe.
+namespace groupFieldShadow {
+
+struct Bounds {
+    int x, y, width, height;
+    bool operator==(const Bounds &) const = default;
+
+    int index(int px, int py) const
+    {
+        const int localX = px - x;
+        const int localY = py - y;
+        return localX >= 0 && localX < width && localY >= 0 && localY < height
+            ? localY * width + localX : -1;
+    }
+};
+
+using FrontierNode = std::pair<int, int>;
+constexpr int farCost = std::numeric_limits<int>::max();
+
+struct Field {
+    Field(int goal, int cells, unsigned used)
+        : goal(goal), used(used), cost(cells, farCost), next(cells, -1), settled(cells)
+    {
+        cost[goal] = 0;
+        frontier.emplace(0, goal);
+    }
+
+    int goal;
+    int horizon = 0;
+    unsigned used;
+    std::vector<int> cost;
+    std::vector<int> next;
+    std::vector<unsigned char> settled;
+    std::priority_queue<FrontierNode, std::vector<FrontierNode>, std::greater<FrontierNode>> frontier;
+};
+
+struct Grid {
+    Bounds bounds{};
+    unsigned revision = 0;
+    unsigned sequence = 0;
+    bool ready = false;
+    std::vector<unsigned char> walkable;
+    std::vector<unsigned char> clearance;
+    std::vector<Field> fields;
+
+    template<class Classify>
+    void rebuild(Bounds area, unsigned topology, Classify classify)
+    {
+        bounds = area;
+        revision = topology;
+        fields.clear();
+        const int count = bounds.width * bounds.height;
+        walkable.resize(count);
+        clearance.assign(count, 0);
+        std::vector<unsigned char> terrain(count);
+        for (int i = 0; i < count; ++i) {
+            const auto [open, canStep] = classify(bounds.x + i % bounds.width, bounds.y + i / bounds.width);
+            terrain[i] = open;
+            walkable[i] = canStep;
+        }
+        for (int i = 0; i < count; ++i) {
+            if (!walkable[i])
+                continue;
+            clearance[i] = 1;
+            const int x = i % bounds.width;
+            const int y = i / bounds.width;
+            for (int radius = 1; radius <= 3; ++radius) {
+                if (x < radius || y < radius || x + radius > bounds.width || y + radius > bounds.height)
+                    break;
+                bool fits = true;
+                for (int dy = -radius; dy < radius && fits; ++dy) {
+                    const bool omitCorners = radius > 1 && (dy == -radius || dy == radius - 1);
+                    for (int dx = -radius + omitCorners; dx < radius - omitCorners; ++dx) {
+                        if (!terrain[i + dy * bounds.width + dx]) {
+                            fits = false;
+                            break;
+                        }
+                    }
+                }
+                if (!fits)
+                    break;
+                clearance[i] = static_cast<unsigned char>(radius * 2);
+            }
+        }
+        ready = true;
+    }
+
+    Field &fieldFor(int goal)
+    {
+        const unsigned used = ++sequence;
+        for (Field &field : fields) {
+            if (field.goal == goal) {
+                field.used = used;
+                return field;
+            }
+        }
+        const int count = bounds.width * bounds.height;
+        if (fields.size() == 8) {
+            const auto oldest = std::min_element(fields.begin(), fields.end(),
+                [](const Field &a, const Field &b) { return a.used < b.used; });
+            *oldest = Field(goal, count, used);
+            return *oldest;
+        }
+        fields.emplace_back(goal, count, used);
+        return fields.back();
+    }
+
+    unsigned extend(Field &field, int from)
+    {
+        unsigned visitCount = 0;
+        while (!field.settled[from] && !field.frontier.empty()) {
+            const auto [cost, index] = field.frontier.top();
+            field.frontier.pop();
+            if (cost != field.cost[index] || field.settled[index])
+                continue;
+            field.settled[index] = 1;
+            field.horizon = cost;
+            ++visitCount;
+            const int x = index % bounds.width;
+            const int y = index / bounds.width;
+            for (int dy = -1; dy <= 1; ++dy) {
+                for (int dx = -1; dx <= 1; ++dx) {
+                    if ((!dx && !dy) || x + dx < 0 || x + dx >= bounds.width ||
+                        y + dy < 0 || y + dy >= bounds.height)
+                        continue;
+                    const int predecessor = index + dy * bounds.width + dx;
+                    if (!walkable[predecessor])
+                        continue;
+                    if (dx && dy && !walkable[index + dx] && !walkable[index + dy * bounds.width])
+                        continue;
+
+                    // Reverse traversal charges the cost of entering the current cell.
+                    const int newCost = cost + (dx && dy ? 15 : 10) + 6 * (6 - clearance[index]);
+                    if (newCost < field.cost[predecessor]) {
+                        field.cost[predecessor] = newCost;
+                        field.next[predecessor] = index;
+                        field.frontier.emplace(newCost, predecessor);
+                    }
+                }
+            }
+        }
+        return visitCount;
+    }
+};
+
+inline Grid grid;
+
+struct LiveSearch {
+    struct Entry {
+        unsigned generation = 0;
+        int cost = farCost;
+        int parent = -1;
+        int width = -1;
+    };
+
+    struct Result {
+        unsigned expanded = 0;
+        unsigned steps = 0;
+        unsigned probes = 0;
+        int width = 6;
+        double length = 0;
+        const char *status = "not_needed";
+        std::vector<int> reverseRoute;
+    };
+
+    std::vector<Entry> cells;
+    unsigned generation = 0;
+
+    Entry &entry(int index)
+    {
+        Entry &item = cells[index];
+        if (item.generation != generation) {
+            item = Entry{};
+            item.generation = generation;
+        }
+        return item;
+    }
+
+    template<class Validate>
+    Result run(const Grid &grid, const Field &field, int start, int goal, Validate validate)
+    {
+        Result result;
+        result.status = "unreachable";
+        constexpr unsigned budget = 4096;
+        const Bounds area = grid.bounds;
+        const int count = area.width * area.height;
+        if (cells.size() != static_cast<unsigned>(count))
+            cells.assign(count, Entry{});
+        if (++generation == 0) {
+            cells.assign(count, Entry{});
+            ++generation;
+        }
+
+        const auto lowerBound = [&](int index) {
+            const int dx = std::abs(index % area.width - goal % area.width);
+            const int dy = std::abs(index / area.width - goal / area.width);
+            const int geometry = 10 * std::max(dx, dy) + 5 * std::min(dx, dy);
+            return field.settled[index] ? field.cost[index] : std::max(geometry, field.horizon);
+        };
+        const auto width = [&](int index) {
+            Entry &item = entry(index);
+            if (item.width < 0) {
+                const auto [freeWidth, blocked, zone] = validate(
+                    area.x + index % area.width, area.y + index / area.width);
+                item.width = blocked || !zone ? 0 : freeWidth;
+                ++result.probes;
+            }
+            return item.width;
+        };
+
+        using Node = std::tuple<int, int, int>;
+        std::priority_queue<Node, std::vector<Node>, std::greater<Node>> frontier;
+        entry(start).cost = 0;
+        frontier.emplace(lowerBound(start), 0, start);
+        while (!frontier.empty() && result.expanded < budget) {
+            const auto [priority, negativeCost, index] = frontier.top();
+            frontier.pop();
+            const int cost = -negativeCost;
+            if (entry(index).cost != cost)
+                continue;
+            ++result.expanded;
+            if (index == goal) {
+                result.status = "repaired";
+                int node = goal;
+                while (node != start) {
+                    const Entry &item = entry(node);
+                    if (item.parent < 0 || item.parent >= count || item.width < 1 ||
+                        entry(item.parent).cost >= item.cost || result.steps >= static_cast<unsigned>(count)) {
+                        result.status = "broken_repair";
+                        break;
+                    }
+                    result.reverseRoute.push_back(node);
+                    result.width = std::min(result.width, item.width);
+                    result.length += (node % area.width != item.parent % area.width &&
+                        node / area.width != item.parent / area.width) ? 1.4142135623730951 : 1.0;
+                    ++result.steps;
+                    node = item.parent;
+                }
+                return result;
+            }
+
+            const int x = index % area.width;
+            const int y = index / area.width;
+            for (int dy = -1; dy <= 1; ++dy) {
+                for (int dx = -1; dx <= 1; ++dx) {
+                    if ((!dx && !dy) || x + dx < 0 || x + dx >= area.width ||
+                        y + dy < 0 || y + dy >= area.height)
+                        continue;
+                    const int neighbor = index + dy * area.width + dx;
+                    if (!grid.walkable[neighbor])
+                        continue;
+                    const int lowerCost = cost + (dx && dy ? 15 : 10) + 6 * (6 - grid.clearance[neighbor]);
+                    Entry &item = entry(neighbor);
+                    if (lowerCost >= item.cost)
+                        continue;
+                    const int available = width(neighbor);
+                    if (available < 1)
+                        continue;
+                    if (dx && dy) {
+                        const int sideX = index + dx;
+                        const int sideY = index + dy * area.width;
+                        if ((!grid.walkable[sideX] || width(sideX) < 1) &&
+                            (!grid.walkable[sideY] || width(sideY) < 1))
+                            continue;
+                    }
+                    const int newCost = lowerCost + 6 * std::max(0, int(grid.clearance[neighbor])-available);
+                    if (newCost >= item.cost)
+                        continue;
+                    item.cost = newCost;
+                    item.parent = index;
+                    frontier.emplace(newCost + lowerBound(neighbor), -newCost, neighbor);
+                }
+            }
+        }
+        if (!frontier.empty())
+            result.status = "budget";
+        return result;
+    }
+};
+
+inline LiveSearch liveSearch;
+
+struct ZoneSnapshot {
+    int columns=0, rows=0;
+    std::vector<unsigned char> passable;
+
+    template<class Read>
+    void capture(int width,int height,Read read)
+    {
+        if (width<=0 || height<=0 || static_cast<long long>(width)*height>1048576) {
+            columns=rows=0;
+            passable.clear();
+            return;
+        }
+        columns=width;
+        rows=height;
+        passable.resize(static_cast<std::size_t>(columns)*rows);
+        for (int x=0;x<columns;++x)
+            for (int y=0;y<rows;++y)
+                passable[x*rows+y]=read(x,y);
+    }
+
+    bool allows(int x,int y,int block) const
+    {
+        const auto valid=[&](int cx,int cy) {
+            const int bx=cx/block, by=cy/block;
+            return bx>=0 && bx<columns && by>=0 && by<rows && passable[bx*rows+by]!=0;
+        };
+        return valid(x,y) || valid(x+3,y+3) || valid(x-3,y+3) || valid(x+3,y-3) || valid(x-3,y-3);
+    }
+};
+
+inline unsigned optimizedMatch(Path *legacy,Path *candidate)
+{
+    if (!legacy || !candidate || legacy->getBlockedByAlly()!=candidate->getBlockedByAlly())
+        return 0;
+    const PathNode *original=legacy->getFirstNode();
+    const PathNode *comparison=candidate->getFirstNode();
+    unsigned nodes=0;
+    while (original && comparison) {
+        const auto &a=*original->getPosition();
+        const auto &b=*comparison->getPosition();
+        if (std::bit_cast<std::uint32_t>(a.x)!=std::bit_cast<std::uint32_t>(b.x) ||
+            std::bit_cast<std::uint32_t>(a.y)!=std::bit_cast<std::uint32_t>(b.y) ||
+            std::bit_cast<std::uint32_t>(a.z)!=std::bit_cast<std::uint32_t>(b.z) ||
+            original->getLayer()!=comparison->getLayer())
+            return 0;
+        ++nodes;
+        if (nodes>1048576)
+            return 0;
+        original=original->getNextOptimized();
+        comparison=comparison->getNextOptimized();
+    }
+    return original || comparison ? 0 : nodes;
+}
+
+
+
+inline FILE *log()
+{
+    static FILE *output = [] {
+        const char *path = std::getenv("ZH_FORMATION_FIELD_SHADOW");
+        FILE *file = path ? std::fopen(path, "w") : nullptr;
+        if (file) {
+            std::setvbuf(file, nullptr, _IOFBF, 65536);
+            std::fprintf(file, "scope,frame,raw_x,raw_y,start_x,start_y,goal_x,goal_y,revision,legacy_return,status,expanded,steps,min_live_width,center_blocked,zone_reject,static_us,search_us,validate_us,shadow_length,legacy_length,repair_status,repair_expanded,repair_steps,repair_probes,repair_width,repair_length,repair_us,zone_snapshot_us,materialize_us,built_candidate,matching_optimized_nodes\n");
+        }
+        return file;
+    }();
+    return output;
+}
+
+struct Row {
+    unsigned expanded = 0;
+    unsigned steps = 0;
+    int minWidth = 6;
+    bool centerBlocked = false;
+    bool zoneReject = false;
+    const char *status = "not_ready";
+    double staticUs = 0;
+    double searchUs = 0;
+    double validationUs = 0;
+    double shadowLength = 0;
+    double repairUs = 0;
+    LiveSearch::Result repair;
+    double materializeUs=0;
+    bool builtCandidate=false;
+    unsigned matchingNodes=0;
+};
+
+inline double elapsed(LARGE_INTEGER start, LARGE_INTEGER end)
+{
+    static const auto frequency = [] {
+        LARGE_INTEGER f{};
+        QueryPerformanceFrequency(&f);
+        return f.QuadPart;
+    }();
+    return (end.QuadPart - start.QuadPart) * 1000000.0 / frequency;
+}
+
+struct Query {
+    Query(const zhpf::Trace &trace, const Coord3D &raw)
+        : output(trace.detailed && trace.frame >= 16978 && trace.frame <= 17277 ? log() : nullptr),
+          frame(trace.frame), scope(trace.counters.request),
+          rawX(zhpf::Trace::cell(raw.x)), rawY(zhpf::Trace::cell(raw.y))
+    {
+    }
+
+    void start(int sx, int sy, int gx, int gy)
+    {
+        if (!output)
+            return;
+        startX = sx;
+        startY = sy;
+        goalX = gx;
+        goalY = gy;
+        revision = lastStandCensus::navigationRevision;
+        occupancy = lastStandCensus::fixedOccupancyRevision;
+        eligible = true;
+    }
+
+    template<class Classify, class Validate, class Materialize>
+    void run(Path *legacy, Bounds area, Classify classify, Validate validate, Materialize materialize)
+    {
+        if (!output)
+            return;
+
+        Row row;
+        std::vector<int> forwardRoute;
+        if (eligible && revision == lastStandCensus::navigationRevision &&
+            occupancy == lastStandCensus::fixedOccupancyRevision && area.width > 0 &&
+            area.height > 0 && static_cast<long long>(area.width) * area.height <= 1048576) {
+            LARGE_INTEGER begin{}, end{};
+            QueryPerformanceCounter(&begin);
+            if (!grid.ready || grid.bounds != area || grid.revision != revision) {
+                grid.rebuild(area, revision, classify);
+                QueryPerformanceCounter(&end);
+                row.staticUs = elapsed(begin, end);
+                begin = end;
+            }
+
+            const int start = area.index(startX, startY);
+            const int goal = area.index(goalX, goalY);
+            row.status = "outside_graph";
+            if (start >= 0 && goal >= 0 && grid.walkable[start] && grid.walkable[goal]) {
+                Field &field = grid.fieldFor(goal);
+                row.expanded = grid.extend(field, start);
+                QueryPerformanceCounter(&end);
+                row.searchUs = elapsed(begin, end);
+
+                row.status = "static_unreachable";
+                if (field.settled[start]) {
+                    int node = start;
+                    row.status = "reachable";
+                    const int count = area.width * area.height;
+                    while (node != goal) {
+                        const int following = field.next[node];
+                        if (following < 0 || following >= count ||
+                            field.cost[following] >= field.cost[node] || row.steps >= static_cast<unsigned>(count)) {
+                            row.status = "broken_field";
+                            break;
+                        }
+                        const int x = following % area.width;
+                        const int y = following / area.width;
+                        auto [width, blocked, zone] = validate(area.x + x, area.y + y);
+                        row.minWidth = std::min(row.minWidth, width);
+                        row.centerBlocked |= blocked;
+                        row.zoneReject |= !zone;
+                        row.shadowLength += (x != node % area.width && y != node / area.width)
+                            ? 1.4142135623730951 : 1.0;
+                        forwardRoute.push_back(following);
+                        ++row.steps;
+                        node = following;
+                    }
+                }
+                LARGE_INTEGER validated{};
+                QueryPerformanceCounter(&validated);
+                row.validationUs = elapsed(end, validated);
+                if (row.status == std::string_view("reachable") &&
+                    (row.centerBlocked || row.zoneReject || row.minWidth < 1)) {
+                    row.repair = liveSearch.run(grid, field, start, goal, validate);
+                    QueryPerformanceCounter(&end);
+                    row.repairUs = elapsed(validated, end);
+                }
+                if (legacy && row.status==std::string_view("reachable")) {
+                    QueryPerformanceCounter(&begin);
+                    if (!row.centerBlocked && !row.zoneReject && row.minWidth>=2) {
+                        std::reverse(forwardRoute.begin(),forwardRoute.end());
+                        row.builtCandidate=true;
+                        row.matchingNodes=materialize(forwardRoute,area,goal);
+                    } else if (row.repair.status==std::string_view("repaired") && row.repair.width>=2) {
+                        row.builtCandidate=true;
+                        row.matchingNodes=materialize(row.repair.reverseRoute,area,goal);
+                    }
+                    QueryPerformanceCounter(&end);
+                    row.materializeUs=elapsed(begin,end);
+                }
+            }
+        } else if (eligible) {
+            row.status = "state_changed";
+        }
+
+        double legacyLength = 0;
+        if (legacy) {
+            const PathNode *previous = nullptr;
+            for (const PathNode *node = legacy->getFirstNode(); node; node = node->getNext()) {
+                if (previous) {
+                    const Coord3D &a = *previous->getPosition();
+                    const Coord3D &b = *node->getPosition();
+                    legacyLength += std::hypot(double(b.x) - a.x, double(b.y) - a.y) / PATHFIND_CELL_SIZE_F;
+                }
+                previous = node;
+            }
+        }
+        std::fprintf(output, "%u,%u,%d,%d,%d,%d,%d,%d,%u,%u,%s,%u,%u,%d,%u,%u,%.3f,%.3f,%.3f,%.3f,%.3f,%s,%u,%u,%u,%d,%.3f,%.3f,%.3f,%.3f,%u,%u\n",
+            scope, frame, rawX, rawY, startX, startY, goalX, goalY, revision, unsigned(legacy != nullptr),
+            row.status, row.expanded, row.steps, row.minWidth, unsigned(row.centerBlocked),
+            unsigned(row.zoneReject), row.staticUs, row.searchUs, row.validationUs,
+            row.shadowLength, legacyLength, row.repair.status, row.repair.expanded,
+            row.repair.steps, row.repair.probes, row.repair.width, row.repair.length, row.repairUs, zoneSnapshotUs, row.materializeUs, unsigned(row.builtCandidate), row.matchingNodes);
+    }
+
+    FILE *output;
+    unsigned frame, scope;
+    int rawX, rawY;
+    int startX = 0, startY = 0, goalX = 0, goalY = 0;
+    unsigned revision = 0, occupancy = 0;
+    bool eligible = false;
+    ZoneSnapshot zone;
+    double zoneSnapshotUs=0;
+    bool center=false;
+};
+
+} // namespace groupFieldShadow
+
+
diff --git a/Core/GameEngine/Source/GameLogic/AI/MovementMemo.h b/Core/GameEngine/Source/GameLogic/AI/MovementMemo.h
new file mode 100644
index 0000000..576a58c
--- /dev/null
+++ b/Core/GameEngine/Source/GameLogic/AI/MovementMemo.h
@@ -0,0 +1,54 @@
+#pragma once
+
+#include "GroundSearch.h"
+
+namespace workerGroundSearch {
+// Reuse a footprint answer only within one immutable request.
+class MovementMemo {
+    struct Entry {
+        unsigned stamp = 0;
+        footprintPolicy::Movement value;
+    };
+
+public:
+    void begin(Bounds region)
+    {
+        grid = region;
+        entries.resize(std::size_t(grid.right-grid.left) * (grid.bottom-grid.top));
+        if (++generation == 0) {
+            std::fill(entries.begin(), entries.end(), Entry{});
+            generation = 1;
+        }
+    }
+
+    template<class Read>
+    std::optional<footprintPolicy::Movement> get(Point p, Read read)
+    {
+        if (!grid.contains(p))
+            return read(p);
+        auto &entry = entries[std::size_t(p.y-grid.top) * (grid.right-grid.left) + p.x-grid.left];
+        if (entry.stamp == generation)
+            return entry.value;
+        const auto value = read(p);
+        if (value)
+            entry = {generation,*value};
+        return value;
+    }
+
+private:
+    Bounds grid{};
+    std::vector<Entry> entries;
+    unsigned generation = 0;
+};
+
+template<class Access>
+struct MemoizedAccess {
+    Access &input;
+    MovementMemo &memo;
+    auto cell(Point p) { return input.cell(p); }
+    auto terrain(Point p,const Cell &cell,bool dozer) { return input.terrain(p,cell,dozer); }
+    auto move(Point p) { return memo.get(p,[&](Point next) { return input.move(next); }); }
+    auto zone(Point p) { return input.zone(p); }
+    auto height(Point p) { return input.height(p); }
+};
+}
diff --git a/Core/GameEngine/Source/GameLogic/AI/PathGridSnapshot.h b/Core/GameEngine/Source/GameLogic/AI/PathGridSnapshot.h
new file mode 100644
index 0000000..e8d8e19
--- /dev/null
+++ b/Core/GameEngine/Source/GameLogic/AI/PathGridSnapshot.h
@@ -0,0 +1,112 @@
+#pragma once
+
+#include <array>
+#include <cassert>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+// Writers and publication run on the simulation thread. A published page
+// remains immutable until every snapshot referencing it has been destroyed.
+template<class Cell>
+class PathGridSnapshot {
+    static constexpr unsigned side = 16;
+    using Page = std::array<Cell, side * side>;
+
+    struct Location {
+        std::size_t page;
+        std::size_t cell;
+    };
+
+    static Location locate(unsigned width, unsigned height, unsigned x, unsigned y)
+    {
+        assert(x < width && y < height);
+        const auto columns = (width + side - 1) / side;
+        return {std::size_t(y / side) * columns + x / side, (y % side) * side + x % side};
+    }
+
+public:
+    class Snapshot {
+        friend class PathGridSnapshot;
+        unsigned width, height;
+        std::vector<std::shared_ptr<const Page>> pages;
+
+        Snapshot(unsigned width, unsigned height, const std::vector<std::shared_ptr<Page>> &live)
+            : width(width), height(height), pages(live.begin(), live.end()) {}
+
+    public:
+        std::size_t pageCount() const { return pages.size(); }
+
+        const Cell &view(unsigned x, unsigned y) const
+        {
+            auto [page, cell] = locate(width, height, x, y);
+            return (*pages[page])[cell];
+        }
+
+        Cell read(unsigned x, unsigned y, std::vector<bool> &seen, std::vector<std::size_t> &reads) const
+        {
+            auto [page, cell] = locate(width, height, x, y);
+            if (!seen[page]) {
+                seen[page] = true;
+                reads.push_back(page);
+            }
+            return (*pages[page])[cell];
+        }
+    };
+
+    PathGridSnapshot(unsigned width, unsigned height)
+        : width(width), height(height)
+    {
+        pages.resize(std::size_t((width + side - 1) / side) * ((height + side - 1) / side));
+        writableAt.resize(pages.size());
+        for (auto &page : pages)
+            page = std::make_shared<Page>();
+    }
+
+    bool write(unsigned x, unsigned y, const Cell &value)
+    {
+        auto [page, cell] = locate(width, height, x, y);
+        auto &live = pages[page];
+        if ((*live)[cell] == value)
+            return false;
+        if (writableAt[page] != generation) {
+            live = std::make_shared<Page>(*live);
+            writableAt[page] = generation;
+        }
+        (*live)[cell] = value;
+        return true;
+    }
+
+    std::size_t changedPages(const Snapshot &snapshot) const
+    {
+        assert(snapshot.width == width && snapshot.height == height);
+        std::size_t changed = 0;
+        for (std::size_t i = 0; i < pages.size(); ++i)
+            changed += snapshot.pages[i].get() != pages[i].get();
+        return changed;
+    }
+
+    Snapshot freeze()
+    {
+        ++generation;
+        return Snapshot(width, height, pages);
+    }
+
+    bool validate(const Snapshot &snapshot, const std::vector<std::size_t> &reads) const
+    {
+        if (snapshot.width != width || snapshot.height != height)
+            return false;
+        for (auto page : reads) {
+            if (snapshot.pages[page].get() != pages[page].get())
+                return false;
+        }
+        return true;
+    }
+
+private:
+    unsigned width, height;
+    std::uint64_t generation = 0;
+    std::vector<std::shared_ptr<Page>> pages;
+    std::vector<std::uint64_t> writableAt;
+};
diff --git a/Core/GameEngine/Source/GameLogic/AI/PathfindTelemetry.inc b/Core/GameEngine/Source/GameLogic/AI/PathfindTelemetry.inc
new file mode 100644
index 0000000..e7c1b3c
--- /dev/null
+++ b/Core/GameEngine/Source/GameLogic/AI/PathfindTelemetry.inc
@@ -0,0 +1,212 @@
+// T-022: included only by AIPathfind.cpp, after engine headers.
+#include "Common/PathfindTelemetry.h"
+#include "Common/PathfindHeap.h"
+#include "Common/OptimizationPolicy.h"
+#include "Common/LastStandPathCensus.h"
+#include "Common/PathfindBox.h"
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+namespace zhpf {
+inline FILE *requestLog=nullptr, *frameLog=nullptr;
+inline FILE *censusLog=nullptr;
+inline const Object *censusActor=nullptr;
+inline bool initialized=false;
+inline LARGE_INTEGER frequency;
+inline unsigned nextRequest=0;
+inline unsigned requests=0, expansionsTotal=0, peakOpen=0;
+inline unsigned hpaAttempts=0, hpaRetries=0, hpaRejected=0;
+inline unsigned groupCacheHits=0, groupCacheMisses=0;
+inline double totalUs=0, maxUs=0;
+inline bool allowed() {
+    return TheGameLogic && TheGameLogic->isInGame() && !TheGameLogic->isInShellGame()
+        && !TheGameLogic->isInMultiplayerGame() && !TheGameLogic->isInReplayGame();
+}
+inline bool telemetryAllowed() {
+    return allowed() || (TheGameLogic && TheGameLogic->isInReplayGame());
+}
+inline bool heapAllowed() {
+    static const bool matchSkirmishHeap = zh::parseBoolean(getenv("ZH_PROFILE_MATCH_HEAP"), false);
+    if (!allowed() && !(matchSkirmishHeap && TheGameLogic && TheGameLogic->isInReplayGame()))
+        return false;
+    // T-022/T-035 follow-up: the stable heap is the default for singleplayer pathfinding.
+    // allowed() already excludes multiplayer and replays, where the retail List stays in use.
+    // ZH_PF_HEAP=0 (or any invalid token) restores List for tests and troubleshooting.
+    const char *env = getenv("ZH_PF_HEAP");
+    if (env)
+        return zh::parseBoolean(env, false);
+    return true;
+}
+inline void init() {
+    if(initialized) return;
+    initialized=true;
+    QueryPerformanceFrequency(&frequency);
+    const char *p=static_cast<const char*>(nullptr); if(p && *p) requestLog=fopen(p,"w");
+    p=getenv("ZH_PF_FRAME"); if(p && *p) frameLog=fopen(p,"w");
+    p=lastStandCensus::outputPath();
+    if (p && *p) {
+        censusLog=fopen(p,"w");
+        if (censusLog) {
+            setvbuf(censusLog, nullptr, _IOFBF, 262144);
+            fprintf(censusLog, "frame,scope,parent,kind,reason,object,player,ai,target,surfaces,crusher,closest,ignore,blocked,queue_age,queue_depth,revision,fallback,from_x,from_y,to_x,to_y,from_layer,to_layer,has_goal,returned,end_x,end_y,expansions,usec,route_hash,corridor_hash,box_x0,box_y0,box_x1,box_y1,box_cells\n");
+        }
+    }
+    p=static_cast<const char*>(nullptr); if(p && *p) operationLog=fopen(p,"w");
+    if(operationLog) fprintf(operationLog,"request,op,cell,cost\n");
+    if(requestLog) fprintf(requestLog,"frame,kind,object,fromX,fromY,toX,toY,found,expansions,pushes,removes,maxOpen,pathLen,usec,fallback,expansionHash,pathHash\n");
+    if(requestLog) fprintf(requestLog,"# queue=%s\n",heapAllowed()?"heap":"list");
+    if(frameLog) fprintf(frameLog,"frame,requests,usec_total,usec_max,expansions_total,cmax_open,update_usec,hpa_attempts,hpa_retries,hpa_rejected,group_cache_hits,group_cache_misses\n");
+}
+inline void flushFrame(unsigned frame,long long updateTicks) {
+    if(!initialized && telemetryAllowed() && getenv("ZH_PF_FRAME")) init();
+    if(!initialized) return;
+    if(frameLog && telemetryAllowed()) {
+        fprintf(frameLog,"%u,%u,%.3f,%.3f,%u,%u,%.3f,%u,%u,%u,%u,%u\n",frame,requests,totalUs,maxUs,expansionsTotal,peakOpen,updateTicks*1000000.0/frequency.QuadPart,hpaAttempts,hpaRetries,hpaRejected,groupCacheHits,groupCacheMisses);
+        fflush(frameLog);
+    }
+    if(requestLog) fflush(requestLog);
+    if(operationLog) fflush(operationLog);
+    if(censusLog && frame % 30 == 0) fflush(censusLog);
+    requests=expansionsTotal=peakOpen=0; totalUs=maxUs=0;
+    hpaAttempts=hpaRetries=hpaRejected=0; groupCacheHits=groupCacheMisses=0;
+}
+inline bool bucketSearch(const char *kind) {
+    if (!HeapContext::bucketMode())
+        return false;
+    if (std::strcmp(kind,"findGroundPath")==0)
+        return true;
+    static const bool units=zh::parseBoolean(getenv("ZH_UNIT_BUCKETS"),false);
+    return units && (std::strcmp(kind,"internalFindPath")==0 ||
+        std::strcmp(kind,"findClosestPath")==0 || std::strcmp(kind,"findAttackPath")==0);
+}
+inline void seedWithPool(PathfindCell *cell,unsigned cost,void *list) {
+    const unsigned slot=activeHeap && activeHeap->usingPool ? cell->getInfoPoolSlot() : HeapContext::absent;
+    seedHeap(cell,cost,list,slot);
+}
+struct Trace {
+    HeapScope heap;
+    Counters counters;
+    Counters *previous=nullptr;
+    const char *kind;
+    unsigned object=0, frame=0;
+    Coord3D from{}, to{};
+    LARGE_INTEGER start{};
+    bool enabled=false, fallback=false;
+    bool detailed=false, hasGoal=false, closest=false;
+    unsigned surfaces=0, ignoredObstacle=0, crusher=0;
+    int human=-1;
+    const Object *actor=nullptr, *previousActor=nullptr;
+    lastStandCensus::Context context;
+
+    void setCoarseInputs(unsigned mask, bool isHuman, bool canCrush,
+                         bool allowsClosest, unsigned ignored)
+    {
+        if (!detailed) return;
+        surfaces=mask;
+        human=isHuman;
+        crusher=canCrush;
+        closest=allowsClosest;
+        ignoredObstacle=ignored;
+    }
+
+    static int cell(float coordinate)
+    {
+        return static_cast<int>(std::floor(coordinate / PATHFIND_CELL_SIZE_F));
+    }
+    Trace(const char *k, const Object *obj, const Coord3D *f, const Coord3D *t):heap(heapAllowed(),bucketSearch(k)),kind(k) {
+        // Collect diagnostic timings only when a frame log is requested.
+        if(!telemetryAllowed()) return;
+        frame=TheGameLogic->getFrame();
+        detailed=lastStandCensus::capture(frame);
+        if(!detailed && !getenv("ZH_PF_FRAME")) return;
+        init();
+        enabled=requestLog || frameLog || operationLog || (detailed && censusLog);
+        if(!enabled) return;
+        object=obj?obj->getID():0;
+        if (detailed) {
+            context=lastStandCensus::context;
+            previousActor=censusActor;
+            actor=obj ? obj : censusActor;
+            censusActor=actor;
+            hasGoal=t!=nullptr;
+            surfaces=context.surfaces;
+            if (actor) crusher=actor->getCrusherLevel();
+        }
+        if(f) from=*f; if(t) to=*t;
+#if RETAIL_COMPATIBLE_PATHFINDING
+        fallback=!s_useFixedPathfinding;
+#endif
+        counters.request=++nextRequest;
+        previous=active; active=&counters;
+        if (!previous)
+            zhPathBox::reset();
+        operation('B',0,fallback?1:0);
+        QueryPerformanceCounter(&start);
+    }
+    Path *finish(Path *path) {
+        if(!enabled) return path;
+        LARGE_INTEGER end; QueryPerformanceCounter(&end);
+        const double us=(end.QuadPart-start.QuadPart)*1000000.0/frequency.QuadPart;
+        unsigned length=0; uint64_t hash=14695981039346656037ull;
+        if(path) for(PathNode *node=path->getFirstNode();node;node=node->getNext()) {
+            ++length;
+            const Coord3D *pos=node->getPosition();
+            // Hash float bit patterns and layers, with no numeric rounding.
+            for(float v : {pos->x,pos->y,pos->z}) {
+                uint32_t bits; memcpy(&bits,&v,sizeof(bits)); hash^=bits; hash*=1099511628211ull;
+            }
+            hash^=static_cast<unsigned>(node->getLayer()); hash*=1099511628211ull;
+        }
+        operation('E',0,0);
+        if(requestLog) fprintf(requestLog,"%u,%s,%u,%.9g,%.9g,%.9g,%.9g,%u,%u,%u,%u,%u,%u,%.3f,%u,%llu,%llu\n",
+            frame,kind,object,from.x,from.y,to.x,to.y,path!=nullptr,counters.expansions,counters.pushes,counters.removes,
+            counters.maxOpen,length,us,fallback,counters.expansionHash,hash);
+        if (detailed && censusLog) {
+            const Player *player=actor ? actor->getControllingPlayer() : nullptr;
+            unsigned actorId=object ? object : actor ? static_cast<unsigned>(actor->getID()) : context.actor;
+            const Object *owner=actor ? actor : actorId ? TheGameLogic->findObjectByID(static_cast<ObjectID>(actorId)) : nullptr;
+            if (!player && owner) player=owner->getControllingPlayer();
+            int playerIndex=player ? static_cast<int>(player->getPlayerIndex()) : -1;
+            int ai=human>=0 ? !human : player ? player->getPlayerType()==PLAYER_COMPUTER : -1;
+            int fromLayer=owner ? static_cast<int>(owner->getLayer()) : static_cast<int>(TheTerrainLogic->getLayerForDestination(&from));
+            int toLayer=hasGoal ? static_cast<int>(TheTerrainLogic->getLayerForDestination(&to)) : -1;
+            int endX=0, endY=0;
+            unsigned long long corridor=14695981039346656037ull;
+            int lastX=0, lastY=0, lastLayer=0;
+            bool first=true;
+            if (path) for (const PathNode *node=path->getFirstNode(); node; node=node->getNext()) {
+                const Coord3D &position=*node->getPosition();
+                endX=cell(position.x);
+                endY=cell(position.y);
+                const int x=static_cast<int>(std::floor(endX / 16.0));
+                const int y=static_cast<int>(std::floor(endY / 16.0));
+                const int layer=node->getLayer();
+                if (first || x!=lastX || y!=lastY || layer!=lastLayer) {
+                    for (int component : {x,y,layer}) {
+                        corridor ^= static_cast<unsigned>(component);
+                        corridor *= 1099511628211ull;
+                    }
+                    first=false;
+                    lastX=x;
+                    lastY=y;
+                    lastLayer=layer;
+                }
+            }
+            fprintf(censusLog,"%u,%u,%u,%s,%s,%u,%d,%d,%u,%u,%u,%u,%u,%u,%d,%d,%u,%u,%d,%d,%d,%d,%d,%d,%u,%u,%d,%d,%u,%.3f,%llu,%llu,%d,%d,%d,%d,%u\n",
+                frame,counters.request,previous?previous->request:0,kind,context.reason,actorId,playerIndex,ai,context.target,
+                surfaces,crusher,unsigned(closest),ignoredObstacle,unsigned(context.blocked),context.queueAge,context.queueDepth,
+                lastStandCensus::navigationRevision,unsigned(fallback),cell(from.x),cell(from.y),cell(to.x),cell(to.y),
+                fromLayer,toLayer,unsigned(hasGoal),unsigned(path!=nullptr),endX,endY,counters.expansions,us,
+                static_cast<unsigned long long>(hash),corridor,
+                zhPathBox::minX,zhPathBox::minY,zhPathBox::maxX,zhPathBox::maxY,zhPathBox::cells);
+        }
+        // Outer scopes alone contribute to the frame aggregate.
+        if(!previous) lastStandResidual::recordOuterSearch(end.QuadPart-start.QuadPart);
+        if(!previous) { ++requests; totalUs+=us; if(us>maxUs)maxUs=us;
+            expansionsTotal+=counters.expansions; if(counters.maxOpen>peakOpen)peakOpen=counters.maxOpen; }
+        return path;
+    }
+    ~Trace() { if(enabled) active=previous; if(detailed && enabled) censusActor=previousActor; }
+};
+} // namespace zhpf
