+#pragma once
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+
+namespace earlyQueueProbe {
+using Clock = std::chrono::steady_clock;
+inline unsigned occupancyRevision = 0;
+
+inline bool enabled()
+{
+    static bool enabled = std::getenv("ZH_EARLY_QUEUE_LOG") != nullptr;
+    return enabled;
+}
+
+inline FILE *log()
+{
+    static FILE *file = []() -> FILE * {
+        const char *name = std::getenv("ZH_EARLY_QUEUE_LOG");
+        FILE *file = name ? std::fopen(name, "w") : nullptr;
+        if (file)
+            std::fputs("stage,tick,id,rank,history,us,request_equal,navigation,fixed,occupancy\n", file);
+        return file;
+    }();
+    return file;
+}
+
+inline double micros(Clock::time_point start)
+{
+    return std::chrono::duration<double,std::micro>(Clock::now()-start).count();
+}
+}
diff --git a/Core/GameEngine/Source/GameLogic/AI/Pathfinder/MaintainedFormationWidth.h b/Core/GameEngine/Source/GameLogic/AI/Pathfinder/MaintainedFormationWidth.h
new file mode 100644
index 0000000..cf18363
--- /dev/null
+++ b/Core/GameEngine/Source/GameLogic/AI/Pathfinder/MaintainedFormationWidth.h
@@ -0,0 +1,124 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <vector>
+
+#include "GameLogic/Pathfinder/PathfindCell.h"
+
+namespace maintainedFormationWidth {
+
+struct Grid {
+    enum : unsigned char { dirty=255, occupied=254 };
+
+    const PathfindCell *cells=nullptr;
+    int loX=0,loY=0,hiX=-1,hiY=-1,stride=0;
+    std::vector<unsigned char> widths;
+
+    void bind(const PathfindCell *map,int minX,int minY,int maxX,int maxY)
+    {
+        if (cells==map && loX==minX && loY==minY && hiX==maxX && hiY==maxY)
+            return;
+        drop();
+        if (!map || minX<0 || minY<0 || maxX<minX || maxY<minY ||
+            (static_cast<long long>(maxX)+1)*(static_cast<long long>(maxY)+1)>1048576)
+            return;
+        loX=minX; loY=minY; hiX=maxX; hiY=maxY; stride=maxY+1;
+        widths.assign(static_cast<std::size_t>(maxX+1)*stride,dirty);
+        cells=map;
+    }
+
+    void drop()
+    {
+        cells=nullptr;
+    }
+
+    bool covers(int x,int y) const
+    {
+        return cells && x>=loX+3 && x<=hiX-2 && y>=loY+3 && y<=hiY-2;
+    }
+
+    int indexOf(const PathfindCell *cell) const
+    {
+        if (!cells)
+            return -1;
+        const auto address=reinterpret_cast<std::uintptr_t>(cell);
+        const auto origin=reinterpret_cast<std::uintptr_t>(cells);
+        if (address<origin)
+            return -1;
+        const auto delta=address-origin;
+        if (delta>=widths.size()*sizeof(PathfindCell) || delta%sizeof(PathfindCell)!=0)
+            return -1;
+        return static_cast<int>(delta/sizeof(PathfindCell));
+    }
+
+    void invalidate(int index)
+    {
+        if (!cells || index<0)
+            return;
+        const int x=index/stride, y=index%stride;
+        const int first=std::max(loY+3,y-2), last=std::min(hiY-2,y+3);
+        if (first>last)
+            return;
+        for (int cx=std::max(loX+3,x-2);cx<=std::min(hiX-2,x+3);++cx)
+            std::fill(widths.begin()+cx*stride+first,widths.begin()+cx*stride+last+1,dirty);
+    }
+
+    int lookup(int x,int y,unsigned &refreshed)
+    {
+        auto &value=widths[x*stride+y];
+        if (value!=dirty)
+            return value==occupied ? -1 : value;
+        ++refreshed;
+
+        unsigned columns[6]{};
+        for (int i=0;i<6;++i) {
+            const PathfindCell *column=cells+(x-3+i)*stride+y-3;
+            for (int j=0;j<6;++j) {
+                if ((i==0 || i==5) && (j==0 || j==5))
+                    continue;
+                if (column[j].getFlags()==PathfindCell::UNIT_PRESENT_FIXED) {
+                    value=occupied;
+                    return -1;
+                }
+                columns[i]|=unsigned(column[j].getType()!=PathfindCell::CELL_CLEAR)<<j;
+            }
+        }
+        if (!(columns[0]|columns[1]|columns[2]|columns[3]|columns[4]|columns[5])) {
+            value=6;
+        } else {
+            const unsigned widthFour=((columns[1]|columns[4])&0x0c)|
+                ((columns[2]|columns[3])&0x1e);
+            const unsigned widthTwo=(columns[2]|columns[3])&0x0c;
+            value=!widthFour ? 4 : !widthTwo ? 2 : !(columns[3]&0x08) ? 1 : 0;
+        }
+        return value;
+    }
+};
+
+inline Grid grid;
+
+inline unsigned signature(const PathfindCell &cell)
+{
+    return unsigned(cell.getType()!=PathfindCell::CELL_CLEAR) |
+        (unsigned(cell.getFlags()==PathfindCell::UNIT_PRESENT_FIXED)<<1);
+}
+
+class CellChange {
+public:
+    explicit CellChange(const PathfindCell &cell)
+        : m_cell(cell), m_index(grid.indexOf(&cell)), m_before(m_index<0?0:signature(cell)) {}
+
+    ~CellChange()
+    {
+        if (m_index>=0 && signature(m_cell)!=m_before)
+            grid.invalidate(m_index);
+    }
+
+private:
+    const PathfindCell &m_cell;
+    int m_index;
+    unsigned m_before;
+};
+
+} // namespace maintainedFormationWidth
diff --git a/Core/GameEngine/Source/GameLogic/AI/Pathfinder/MixedFormationWidth.h b/Core/GameEngine/Source/GameLogic/AI/Pathfinder/MixedFormationWidth.h
new file mode 100644
index 0000000..d593a56
--- /dev/null
+++ b/Core/GameEngine/Source/GameLogic/AI/Pathfinder/MixedFormationWidth.h
@@ -0,0 +1,248 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <bit>
+#include <vector>
+
+#include "GameLogic/Pathfinder/PathfindCell.h"
+#include "UnitMask.h"
+#include "Common/ResolvedWidthCache.h"
+
+namespace maintainedFormationWidth {
+
+struct Grid {
+    enum : unsigned char { dirty=255, occupied=254 };
+
+    const PathfindCell *cells=nullptr;
+    int loX=0,loY=0,hiX=-1,hiY=-1,stride=0;
+    std::vector<unsigned char> widths;
+    formationWidthRuntime::Cache resolved;
+    std::vector<std::uint32_t> terrainBits, fixedBits;
+    int lanesPerColumn=0;
+    std::vector<std::uint32_t> unitBits;
+
+    void bind(const PathfindCell *map,int minX,int minY,int maxX,int maxY)
+    {
+        if (cells==map && loX==minX && loY==minY && hiX==maxX && hiY==maxY)
+            return;
+        drop();
+        if (!map || minX<0 || minY<0 || maxX<minX || maxY<minY ||
+            (static_cast<long long>(maxX)+1)*(static_cast<long long>(maxY)+1)>1048576)
+            return;
+        loX=minX; loY=minY; hiX=maxX; hiY=maxY; stride=maxY+1;
+        widths.assign(static_cast<std::size_t>(maxX+1)*stride,dirty);
+        cells=map;
+        lanesPerColumn=(stride+31)/32;
+        const auto lanes=static_cast<std::size_t>(maxX+1)*lanesPerColumn;
+        terrainBits.assign(lanes,0);
+        fixedBits.assign(lanes,0);
+        unitBits.assign(lanes,0);
+        for (int x=loX;x<=hiX;++x)
+            for (int y=loY;y<=hiY;++y) {
+                const int index=x*stride+y;
+                setFlags(x,y,cells[index]);
+                setPresence(index,cells[index].getFlags()!=PathfindCell::NO_UNITS);
+            }
+    }
+
+    void drop()
+    {
+        resolved.drop();
+        cells=nullptr;
+    }
+
+    bool covers(int x,int y) const
+    {
+        return cells && x>=loX+3 && x<=hiX-2 && y>=loY+3 && y<=hiY-2;
+    }
+
+    int indexOf(const PathfindCell *cell) const
+    {
+        if (!cells)
+            return -1;
+        const auto address=reinterpret_cast<std::uintptr_t>(cell);
+        const auto origin=reinterpret_cast<std::uintptr_t>(cells);
+        if (address<origin)
+            return -1;
+        const auto delta=address-origin;
+        if (delta>=widths.size()*sizeof(PathfindCell) || delta%sizeof(PathfindCell)!=0)
+            return -1;
+        return static_cast<int>(delta/sizeof(PathfindCell));
+    }
+
+    void setFlags(int x,int y,const PathfindCell &cell)
+    {
+        const int lane=x*lanesPerColumn+y/32;
+        const auto bit=std::uint32_t(1)<<(y%32);
+        terrainBits[lane]=(terrainBits[lane]&~bit) |
+            (cell.getType()!=PathfindCell::CELL_CLEAR ? bit : 0u);
+        fixedBits[lane]=(fixedBits[lane]&~bit) |
+            (cell.getFlags()==PathfindCell::UNIT_PRESENT_FIXED ? bit : 0u);
+    }
