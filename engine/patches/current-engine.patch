+extern double g_zhAttrGuardSubMs;
+extern double g_zhAttrHuntSubHist[ZH_ATTR_AI_STATE_SLOTS];
+extern double g_zhAttrHuntSubMs;
+extern double g_zhAttrHuntScanMs;
