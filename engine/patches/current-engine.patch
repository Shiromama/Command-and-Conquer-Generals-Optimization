+        nativeUnitMemo::invalidate();
+    if (!base)
+        return;
+    const auto address = reinterpret_cast<uintptr_t>(&cell);
+    const auto first = reinterpret_cast<uintptr_t>(base);
+    if (address < first)
+        return;
+    const auto bytes = address - first;
+    if (bytes >= sizeof(PathfindCell) * size_t(width) * height || bytes % sizeof(PathfindCell))
+        return;
+    const auto index = bytes / sizeof(PathfindCell);
+    const unsigned wx = unsigned(index / height), wy = unsigned(index % height);
+    if (writeLog && dispatchActor) {
+        const unsigned frame = TheGameLogic ? TheGameLogic->getFrame() : 0;
+        if (frame >= 14700 && frame <= 17400)
+            std::fprintf(writeLog, "%u,%u,%u,%u\n", frame, dispatchActor, wx, wy);
+    }
+    writes += live->write(wx, wy, capture(cell));
+}
+
+static double micros(Clock::time_point start)
+{
+    return std::chrono::duration<double,std::micro>(Clock::now()-start).count();
+}
+
+static FILE *log()
+{
+    static FILE *file = []() -> FILE * {
+        const char *path = std::getenv("ZH_NATIVE_PAGE_LOG");
+        FILE *result = path ? std::fopen(path, "w") : nullptr;
+        if (result)
+            std::fputs("stage,tick,x,y,pages,changed_pages,changed_cells,publication_us,compare_us,audited,mismatches\n", result);
+        return result;
+    }();
+    return file;
+}
+
+static bool captures(unsigned tick)
+{
+    return tick >= 16800 && tick <= 17277 && log();
+}
+
+static unsigned audit(const Grid::Snapshot &snapshot)
+{
+    unsigned differences = 0;
+    for (unsigned x = 0; x < width; ++x)
+        for (unsigned y = 0; y < height; ++y)
+            differences += snapshot.view(x,y) != capture(base[x*height+y]);
+    return differences;
+}
+
+static bool auditFrame(unsigned tick)
+{
+    return tick == 16800 || tick == 16978 || tick == 17061 ||
+        tick == 17149 || tick == 17277;
+}
+
+static void begin(unsigned tick, PathfindCell *cells, unsigned cols, unsigned rows)
+{
+    if (!captures(tick) || !cells || !cols || !rows)
+        return;
+    if (base != cells || width != cols || height != rows) {
+        drop();
+        width = cols;
+        height = rows;
+        live = std::make_unique<Grid>(cols, rows);
+        for (unsigned x = 0; x < width; ++x)
+            for (unsigned y = 0; y < height; ++y)
+                live->write(x,y,capture(cells[x*height+y]));
+        base = cells;
+    }
+    early.reset();
+    afterScripts.reset();
+    writes = 0;
+    const auto started = Clock::now();
+    early.emplace(live->freeze());
+    const double publishUs = micros(started);
+    const bool checked = auditFrame(tick);
+    std::fprintf(log(),"B,%u,%u,%u,%zu,0,0,%.3f,0,%u,%u\n",tick,width,height,
+        early->pageCount(),publishUs,unsigned(checked),checked ? audit(*early) : 0);
+}
+
+static void dispatch(unsigned tick, char stage)
+{
+    if (!captures(tick) || !early)
+        return;
+    const auto started = Clock::now();
+    const auto differing = live->changedPages(*early);
+    const double compareUs = micros(started);
+    const bool checked = auditFrame(tick) && stage == 'Q';
+    const unsigned mismatches = checked ? audit(live->freeze()) : 0;
+    std::fprintf(log(),"%c,%u,%u,%u,%zu,%zu,%u,0,%.3f,%u,%u\n",stage,tick,width,height,
+        early->pageCount(),differing,writes,compareUs,unsigned(checked),mismatches);
+    if (stage == 'Q' && afterScripts) {
+        const auto started = Clock::now();
+        const auto changed = live->changedPages(*afterScripts);
+        std::fprintf(log(),"P,%u,%u,%u,%zu,%zu,0,0,%.3f,0,0\n",tick,width,height,
+            afterScripts->pageCount(),changed,micros(started));
+    }
+}
+
+static void publishAfterScripts(unsigned tick)
+{
+    if (!captures(tick) || !early)
+        return;
+    const auto started = Clock::now();
+    afterScripts.emplace(live->freeze());
+    std::fprintf(log(),"L,%u,%u,%u,%zu,0,0,%.3f,0,0,0\n",tick,width,height,
+        afterScripts->pageCount(),micros(started));
+}
+}
