+static void logClientPhase(const char *name, LARGE_INTEGER start, LARGE_INTEGER freq)
+{
+	static FILE *phaseFile = nullptr;
+	static Bool phaseInit = FALSE;
+	if (!phaseInit)
+	{
+		phaseInit = TRUE;
+		const char *splitPath = static_cast<const char*>(nullptr);
