new file mode 100644
index 0000000..5dcb697
--- /dev/null
+++ b/Core/GameEngine/Include/Common/ZoneHalo.h
@@ -0,0 +1,82 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <vector>
+
+template<int BlockSize>
+class ZoneHalo {
+public:
+    static_assert(BlockSize>=7);
+
+    void begin(int width,int height)
+    {
+        if (width!=m_width || height!=m_height) {
+            m_width=width;
+            m_height=height;
+            m_tiles.assign(static_cast<std::size_t>(width)*height,{});
+        }
+        if (++m_generation==0) {
+            for (auto &tile:m_tiles)
+                tile.generation=0;
+            ++m_generation;
+        }
+    }
+
+    bool covers(int x,int y) const
+    {
+        return x>=0 && y>=0 && x/BlockSize<m_width && y/BlockSize<m_height;
+    }
+
+    template<class ReadBlock>
+    bool allows(int x,int y,ReadBlock read)
+    {
+        const int bx=x/BlockSize,by=y/BlockSize;
+        auto &tile=m_tiles[static_cast<std::size_t>(bx)*m_height+by];
+        if (tile.generation!=m_generation) {
+            tile.mask=build(bx,by,read);
+            tile.generation=m_generation;
+        }
+        if (tile.mask==0 || tile.mask==all)
+            return tile.mask==all;
+        const unsigned bit=partition(x-bx*BlockSize)*3+partition(y-by*BlockSize);
+        return (tile.mask&(1u<<bit))!=0;
+    }
+
+private:
+    static constexpr std::uint16_t all=(1u<<9)-1;
+    struct Tile { std::uint32_t generation=0; std::uint16_t mask=0; };
+
+    static unsigned partition(int offset)
+    {
+        return static_cast<unsigned>((offset>=3)+(offset>=BlockSize-3));
+    }
+
+    template<class ReadBlock>
+    std::uint16_t build(int bx,int by,ReadBlock read) const
+    {
+        if (read(bx,by))
+            return all;
+        bool blocks[3][3]{};
+        for (int x=0;x<3;++x) {
+            for (int y=0;y<3;++y) {
+                const int ix=std::max(0,bx+x-1),iy=std::max(0,by+y-1);
+                blocks[x][y]=(x!=1 || y!=1) && ix<m_width && iy<m_height && read(ix,iy);
+            }
+        }
+        std::uint16_t result=0;
+        for (unsigned x=0;x<3;++x) {
+            const unsigned left=x==0 ? 0 : 1, right=x==2 ? 2 : 1;
+            for (unsigned y=0;y<3;++y) {
+                const unsigned low=y==0 ? 0 : 1, high=y==2 ? 2 : 1;
+                if (blocks[left][low] || blocks[left][high] || blocks[right][low] || blocks[right][high])
+                    result|=static_cast<std::uint16_t>(1u<<(x*3+y));
+            }
+        }
+        return result;
+    }
+
+    std::vector<Tile> m_tiles;
+    int m_width=0,m_height=0;
+    std::uint32_t m_generation=0;
+};
