+// prove the grid is immutable between searches (per-lane m_info is then the only
+// shared scratch).
+static unsigned long long dispatchWrites = 0;
+// T-127 parallel-safety test: log (frame, owning request, cell) for every static
+// write during the queue dispatch so writes can be checked against other
+// requests' explored boxes.
+static FILE *writeLog = nullptr;
+static bool writeLogInit = false;
+static unsigned dispatchActor = 0;
+static void beginWriteLog()
+{
+    if (writeLogInit)
+        return;
+    writeLogInit = true;
+    const char *path = std::getenv("ZH_PATH_WRITE_LOG");
+    if (path && *path) {
+        writeLog = std::fopen(path, "w");
+        if (writeLog)
+            std::fputs("frame,actor,x,y\n", writeLog);
+    }
+}
+static std::unique_ptr<Grid> live;
+static std::optional<Grid::Snapshot> early;
+static std::optional<Grid::Snapshot> afterScripts;
+
+static Cell capture(const PathfindCell &cell)
+{
+    unsigned terrain = unsigned(cell.getType()) | (unsigned(cell.getFlags()) << 4) |
+        (unsigned(cell.getLayer()) << 8) | (unsigned(cell.getConnectLayer()) << 12) |
+        (cell.getPinched() ? 1u << 16 : 0u) | (cell.isAircraftGoal() ? 1u << 17 : 0u);
+    if (cell.getType() == PathfindCell::CELL_OBSTACLE) {
+        terrain |= (cell.isObstacleFence() ? 1u << 18 : 0u) |
+            (cell.isObstacleTransparent() ? 1u << 19 : 0u);
+    }
+    return {unsigned(cell.getPosUnit()), unsigned(cell.getGoalUnit()), unsigned(cell.getGoalAircraft()),
+        unsigned(cell.getObstacleID()), unsigned(cell.getZone()), terrain};
+}
+
+static void drop()
+{
+    early.reset();
+    afterScripts.reset();
+    live.reset();
+    base = nullptr;
+    writes = 0;
+}
+
+void changed(const PathfindCell &cell)
+{
+    ++dispatchWrites;
