+    void setPresence(int index,bool occupied)
+    {
+        const int x=index/stride, y=index%stride;
+        const int lane=x*lanesPerColumn+y/32;
+        const auto bit=std::uint32_t{1}<<(y%32);
+        unitBits[lane]=(unitBits[lane]&~bit) | (occupied ? bit : 0u);
+    }
+
+    bool emptyFootprint(int minX,int minY,int maxX,int maxY,bool requireClearTerrain) const
+    {
+        if (!cells || minX<loX || minY<loY || maxX>hiX || maxY>hiY ||
+            minX>maxX || minY>maxY)
+            return false;
+        return noFootprintBits(unitBits,requireClearTerrain?&terrainBits:nullptr,
+            lanesPerColumn,minX,minY,maxX,maxY);
+    }
+
+    void refresh(int index)
+    {
+        if (!cells || index<0)
+            return;
+        setFlags(index/stride,index%stride,cells[index]);
+        invalidate(index);
+    }
+
+    void invalidate(int index)
+    {
+        if (!cells || index<0)
+            return;
+        const int x=index/stride, y=index%stride;
+        const int first=std::max(loY+3,y-2), last=std::min(hiY-2,y+3);
+        if (first>last)
+            return;
+        for (int cx=std::max(loX+3,x-2);cx<=std::min(hiX-2,x+3);++cx) {
+            const auto a=cx*stride+first,b=cx*stride+last+1;
+            std::fill(widths.begin()+a,widths.begin()+b,dirty);
+            resolved.invalidate(a,b);
+        }
+    }
+
+    unsigned readSix(const std::vector<std::uint32_t> &mask,int x,int first) const
+    {
+        const int lane=x*lanesPerColumn+first/32;
+        const int offset=first%32;
+        unsigned bits=mask[lane]>>offset;
+        if (offset>26)
+            bits|=mask[lane+1]<<(32-offset);
+        return bits&0x3f;
+    }
+
+    template<class Resolve>
+    int mixed(int x,int y,Resolve resolves,unsigned &resolutions) const
+    {
+        unsigned terrain[6]{}, unknown[6]{}, live[6]{};
+        for (int i=0;i<6;++i) {
+            const int cx=x-3+i;
+            terrain[i]=readSix(terrainBits,cx,y-3);
+            unknown[i]=readSix(fixedBits,cx,y-3)&~terrain[i];
+        }
+        for (int radius=3;radius>0;--radius) {
+            const int first=3-radius, last=3+radius-1;
+            bool clear=true;
+            for (int i=first;i<=last;++i) {
+                const int trim=radius>1 && (i==first || i==last);
+                const unsigned section=((1u<<(2*radius-2*trim))-1)<<(first+trim);
+                if ((terrain[i]|live[i])&section) {
+                    clear=false;
+                    break;
+                }
+            }
+            if (!clear)
+                continue;
+            for (int i=first;i<=last && clear;++i) {
+                const int trim=radius>1 && (i==first || i==last);
+                const unsigned section=((1u<<(2*radius-2*trim))-1)<<(first+trim);
+                while (const unsigned candidates=unknown[i]&section) {
+                    const int bit=std::countr_zero(candidates);
+                    const unsigned bitMask=1u<<bit;
+                    unknown[i]&=~bitMask;
+                    ++resolutions;
+                    if (resolves(cells[(x-3+i)*stride+y-3+bit])) {
+                        live[i]|=bitMask;
+                        clear=false;
+                        break;
+                    }
+                }
+            }
+            if (clear)
+                return 2*radius;
+        }
+        return (terrain[3]&0x08)?0:1;
+    }
+
+    int lookup(int x,int y,unsigned &refreshed)
+    {
+        auto &value=widths[x*stride+y];
+        if (value!=dirty)
+            return value==occupied ? -1 : value;
+        ++refreshed;
+
+        unsigned columns[6]{};
+        for (int i=0;i<6;++i) {
+            const PathfindCell *column=cells+(x-3+i)*stride+y-3;
+            for (int j=0;j<6;++j) {
+                if ((i==0 || i==5) && (j==0 || j==5))
+                    continue;
+                if (column[j].getFlags()==PathfindCell::UNIT_PRESENT_FIXED) {
+                    value=occupied;
+                    return -1;
+                }
+                columns[i]|=unsigned(column[j].getType()!=PathfindCell::CELL_CLEAR)<<j;
+            }
+        }
+        if (!(columns[0]|columns[1]|columns[2]|columns[3]|columns[4]|columns[5])) {
+            value=6;
+        } else {
+            const unsigned widthFour=((columns[1]|columns[4])&0x0c)|
+                ((columns[2]|columns[3])&0x1e);
+            const unsigned widthTwo=(columns[2]|columns[3])&0x0c;
+            value=!widthFour ? 4 : !widthTwo ? 2 : !(columns[3]&0x08) ? 1 : 0;
+        }
+        return value;
+    }
+};
+
+inline Grid grid;
+
+inline unsigned signature(const PathfindCell &cell)
+{
+    return unsigned(cell.getType()!=PathfindCell::CELL_CLEAR) |
+        (unsigned(cell.getFlags()==PathfindCell::UNIT_PRESENT_FIXED)<<1);
+}
+
+class CellChange {
+public:
+    explicit CellChange(const PathfindCell &cell)
+        : m_cell(cell), m_index(grid.indexOf(&cell)), m_before(m_index<0?0:signature(cell)),
+          m_hadUnit(m_index>=0 && cell.getFlags()!=PathfindCell::NO_UNITS),
+          m_trackOccupant(m_index>=0 && grid.resolved.ready()),
+          m_fixedId(m_trackOccupant && cell.getFlags()==PathfindCell::UNIT_PRESENT_FIXED ? cell.getPosUnit() : INVALID_ID) {}
+
+    ~CellChange()
+    {
+        if (m_index<0)
+            return;
+        const bool hasUnit=m_cell.getFlags()!=PathfindCell::NO_UNITS;
+        if (hasUnit!=m_hadUnit)
+            grid.setPresence(m_index,hasUnit);
+        if (signature(m_cell)!=m_before) {
+            grid.refresh(m_index);
+        } else if (m_trackOccupant && m_cell.getFlags()==PathfindCell::UNIT_PRESENT_FIXED &&
+                   m_cell.getPosUnit()!=m_fixedId) {
+            grid.invalidate(m_index);
+        }
+    }
+
+private:
+    const PathfindCell &m_cell;
+    int m_index;
+    unsigned m_before;
+    bool m_hadUnit,m_trackOccupant;
+    ObjectID m_fixedId;
+};
+
