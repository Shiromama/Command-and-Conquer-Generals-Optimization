diff --git a/GeneralsMD/Code/GameEngine/Source/GameLogic/AI/MovePipeline.inc b/GeneralsMD/Code/GameEngine/Source/GameLogic/AI/MovePipeline.inc
new file mode 100644
index 0000000..d3dac9d
--- /dev/null
+++ b/GeneralsMD/Code/GameEngine/Source/GameLogic/AI/MovePipeline.inc
@@ -0,0 +1,75 @@
+namespace movePipeline {
+
+inline FILE *log(unsigned frame)
+{
+    if (frame < 16978 || frame > 17277)
+        return nullptr;
+    static FILE *file = [] {
+        const char *name = std::getenv("ZH_MOVE_PIPELINE");
+        FILE *out = name ? std::fopen(name, "w") : nullptr;
+        if (out) {
+            std::setvbuf(out, nullptr, _IOFBF, 65536);
+            std::fprintf(out, "frame,group,source,members,waypoint,depth,total_us,compute_us,infantry_us,vehicles_us,formation_us,compute_calls\n");
+        }
+        return out;
+    }();
+    return file;
+}
+
+inline unsigned nested = 0;
+
+inline double usec(LARGE_INTEGER begin, LARGE_INTEGER end)
+{
+    static const auto frequency = [] {
+        LARGE_INTEGER f{};
+        QueryPerformanceFrequency(&f);
+        return f.QuadPart;
+    }();
+    return (end.QuadPart-begin.QuadPart)*1000000.0/frequency;
+}
+
+struct Timer {
+    Timer(unsigned frame, unsigned group, int source, unsigned members, bool waypoint)
+        : output(log(frame)), frame(frame), group(group), members(members), source(source), waypoint(waypoint)
+    {
+        if (output) {
+            depth = nested++;
+            QueryPerformanceCounter(&begin);
+        }
+    }
+
+    ~Timer()
+    {
+        if (!output)
+            return;
+        LARGE_INTEGER end{};
+        QueryPerformanceCounter(&end);
+        --nested;
+        std::fprintf(output, "%u,%u,%d,%u,%u,%u,%.3f,%.3f,%.3f,%.3f,%.3f,%u\n",
+            frame,group,source,members,unsigned(waypoint),depth,usec(begin,end),
+            compute,infantry,vehicles,formation,computeCalls);
+    }
+
+    template<class Action>
+    auto sample(double &target, Action execute)
+    {
+        if (!output)
+            return execute();
+        LARGE_INTEGER start{}, end{};
+        QueryPerformanceCounter(&start);
+        const auto result = execute();
+        QueryPerformanceCounter(&end);
+        target += usec(start,end);
+        return result;
+    }
+
+    FILE *output;
+    unsigned frame, group, members;
+    int source;
+    bool waypoint;
+    unsigned depth = 0, computeCalls = 0;
+    LARGE_INTEGER begin{};
+    double compute = 0, infantry = 0, vehicles = 0, formation = 0;
+};
+
+}
