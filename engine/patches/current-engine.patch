@@ -0,0 +1,57 @@
+#pragma once
+#include <cstdio>
+#include <cstdlib>
+
+namespace lastStandSequentialOrigin {
+
+struct Origin {
+    const char *script;
+    unsigned team;
+    unsigned opcode;
+    int instruction;
+};
+
+inline thread_local const Origin *current=nullptr;
+
+inline bool enabled(unsigned tick) {
+    static const char *name=std::getenv("ZH_SEQUENTIAL_ORIGIN_LOG");
+    return name && *name && tick>=16978 && tick<=17277;
+}
+
+class Scope {
+public:
+    Scope(bool active, Origin origin) : m_origin(origin), m_previous(current) {
+        if (active)
+            current=&m_origin;
+    }
+    ~Scope() { current=m_previous; }
+private:
+    Origin m_origin;
+    const Origin *m_previous;
+};
+
+inline void record(unsigned frame, unsigned group) {
+    if (!enabled(frame))
+        return;
+    static FILE *const output=[] {
+        FILE *file=std::fopen(std::getenv("ZH_SEQUENTIAL_ORIGIN_LOG"),"w");
+        if (file)
+            std::fputs("frame,group,team,opcode,instruction,script\n",file);
+        return file;
+    }();
+    if (!output)
+        return;
+    if (!current) {
+        std::fprintf(output,"%u,%u,0,0,-1,\n",frame,group);
+        return;
+    }
+    std::fprintf(output,"%u,%u,%u,%u,%d,\"",frame,group,current->team,current->opcode,current->instruction);
+    for (const char *p=current->script; p && *p; ++p) {
+        if (*p=='"')
+            std::fputc('"',output);
+        std::fputc(*p,output);
+    }
+    std::fputs("\"\n",output);
+}
+
+} // namespace lastStandSequentialOrigin
