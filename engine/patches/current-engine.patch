diff --git a/GeneralsMD/Code/Main/WinMain.cpp b/GeneralsMD/Code/Main/WinMain.cpp
index 864c557..0cc44c5 100644
--- a/GeneralsMD/Code/Main/WinMain.cpp
+++ b/GeneralsMD/Code/Main/WinMain.cpp
@@ -38,6 +38,15 @@
 #include <ole2.h>
 #include <dbt.h>
 
+// T-127: request the discrete GPU on hybrid (NVIDIA Optimus) systems. The display
+// driver reads this export from the exe at process start; it is ignored on
+// single-GPU machines. Without it, windowed apps default to the integrated GPU on
+// this laptop (measured: game 3D engine on Intel UHD, dGPU 0% / 9 MiB while a
+// replay ran), which inflates the stencil/present costs. Code-only and portable.
+extern "C" {
+	__declspec(dllexport) unsigned long NvOptimusEnablement = 0x00000001;
+}
+
 // USER INCLUDES //////////////////////////////////////////////////////////////
 #include "WinMain.h"
 #include "Common/CommandLine.h"
@@ -798,6 +807,30 @@ Int APIENTRY WinMain( HINSTANCE hInstance, HINSTANCE hPrevInstance,
 {
 	Int exitcode = 1;
 
+	// PROJECT PATCH (T-023): make the process DPI-aware before any window is created.
+	// Without this, Windows virtualizes the game at 125%/150% scaling (e.g. a 1920x1080
+	// desktop reports a 1536x864 client area), which blurs and scales fullscreen output.
+	{
+		typedef BOOL (WINAPI *PFN_SetProcessDpiAwarenessContext)(HANDLE);
+		typedef BOOL (WINAPI *PFN_SetProcessDPIAware)();
+		HMODULE user32 = GetModuleHandleA("user32.dll");
+		Bool dpiSet = FALSE;
+		if (user32)
+		{
+			PFN_SetProcessDpiAwarenessContext setContext =
+				(PFN_SetProcessDpiAwarenessContext)GetProcAddress(user32, "SetProcessDpiAwarenessContext");
+			if (setContext)
+				dpiSet = setContext((HANDLE)(LONG_PTR)-4); // DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2
+			if (!dpiSet)
+			{
+				PFN_SetProcessDPIAware setAware =
+					(PFN_SetProcessDPIAware)GetProcAddress(user32, "SetProcessDPIAware");
+				if (setAware)
+					dpiSet = setAware();
+			}
+		}
+	}
+
 #ifdef RTS_PROFILE_LEGACY
   Profile::StartRange("init");
 #endif
