diff --git a/Core/GameEngine/Include/Common/OptimizationPolicy.h b/Core/GameEngine/Include/Common/OptimizationPolicy.h
new file mode 100644
index 0000000..ccd1eb0
--- /dev/null
+++ b/Core/GameEngine/Include/Common/OptimizationPolicy.h
@@ -0,0 +1,28 @@
+// T-079: small, dependency-free policy shared by settings, startup and regression tests.
+#pragma once
+#include <cstring>
+#include <cctype>
+namespace zh {
+inline bool tokenEquals(const char *a, const char *b)
+{
+    if (!a) return false;
+    while (*a && *b) {
+        if (std::tolower(static_cast<unsigned char>(*a++)) != *b++) return false;
+    }
+    return *a == *b;
+}
+inline bool parseBoolean(const char *value, bool fallback)
+{
+    if (tokenEquals(value, "yes") || tokenEquals(value, "true") || tokenEquals(value, "1")) return true;
+    if (tokenEquals(value, "no") || tokenEquals(value, "false") || tokenEquals(value, "0")) return false;
+    return fallback;
+}
+inline bool experimentalSimulationAllowed(bool requested, bool multiplayer, bool replay)
+{
+    return requested && !multiplayer && !replay;
+}
+inline bool startupFpsLimit(bool preference, const char *uncappedEnv, bool uncappedCommandLine)
+{
+    return uncappedCommandLine ? false : (uncappedEnv ? !parseBoolean(uncappedEnv, false) : preference);
+}
+} // namespace zh
