diff --git a/Core/GameEngine/Source/GameLogic/AI/Pathfinder/ScopedFixedLaneCache.h b/Core/GameEngine/Source/GameLogic/AI/Pathfinder/ScopedFixedLaneCache.h
new file mode 100644
index 0000000..46b695f
--- /dev/null
+++ b/Core/GameEngine/Source/GameLogic/AI/Pathfinder/ScopedFixedLaneCache.h
@@ -0,0 +1,80 @@
+#pragma once
+
+#include <algorithm>
+#include <bit>
+#include <cstdint>
+#include <vector>
+
+// Once per search, translate a touched column lane into actual obstruction bits.
+template<class Grid>
+class ScopedFixedLaneCache {
+public:
+    void begin(const Grid &map)
+    {
+        m_grid = &map;
+        if (map.fixedBits.size() != m_lanes.size())
+            m_lanes.assign(map.fixedBits.size(), {});
+        if (++m_generation == 0) {
+            std::fill(m_lanes.begin(), m_lanes.end(), Lane{});
+            m_generation = 1;
+        }
+    }
+
+    template<class Resolve>
+    int width(int x, int y, Resolve resolve, unsigned &laneChecks)
+    {
+        std::uint32_t columns[6];
+        const unsigned offset = (y - 3) % 32;
+        for (int column = 0; column < 6; ++column) {
+            const int mapX = x - 3 + column;
+            const int laneY = (y - 3) / 32;
+            const int index = mapX * m_grid->lanesPerColumn + laneY;
+            std::uint32_t blocked = lane(index, mapX, laneY, resolve, laneChecks) >> offset;
+            if (offset > 26)
+                blocked |= lane(index + 1, mapX, laneY + 1, resolve, laneChecks) << (32 - offset);
+            columns[column] = blocked & 0x3f;
+        }
+
+        const auto middle = columns[2] | columns[3];
+        const auto four = columns[1] | columns[4];
+        const auto edges = columns[0] | columns[5];
+        if (!(four | middle | (edges & 0x1e)))
+            return 6;
+        if (!((four & 0x0c) | (middle & 0x1e)))
+            return 4;
+        if (!(middle & 0x0c))
+            return 2;
+        return (m_grid->readSix(m_grid->terrainBits, x, y - 3) & 0x08) ? 0 : 1;
+    }
+
+private:
+    struct Lane { std::uint32_t generation = 0, blocked = 0; };
+
+    template<class Resolve>
+    std::uint32_t lane(int index, int x, int laneY, Resolve &resolve, unsigned &laneChecks)
+    {
+        ++laneChecks;
+        const auto terrain = m_grid->terrainBits[index];
+        auto unknown = m_grid->fixedBits[index] & ~terrain;
+        if (!unknown)
+            return terrain;
+
+        Lane &entry = m_lanes[index];
+        if (entry.generation != m_generation) {
+            const int first = x * m_grid->stride + laneY * 32;
+            auto blocked = terrain;
+            while (unknown) {
+                const auto bit = std::countr_zero(unknown);
+                if (resolve(m_grid->cells[first + bit]))
+                    blocked |= std::uint32_t{1} << bit;
+                unknown &= unknown - 1;
+            }
+            entry = {m_generation, blocked};
+        }
+        return entry.blocked;
+    }
+
+    const Grid *m_grid = nullptr;
+    std::uint32_t m_generation = 0;
+    std::vector<Lane> m_lanes;
+};
diff --git a/Core/GameEngine/Source/GameLogic/AI/Pathfinder/UnitMask.h b/Core/GameEngine/Source/GameLogic/AI/Pathfinder/UnitMask.h
new file mode 100644
index 0000000..05ecc2c
--- /dev/null
+++ b/Core/GameEngine/Source/GameLogic/AI/Pathfinder/UnitMask.h
@@ -0,0 +1,29 @@
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+// Columns correspond to contiguous y coordinates in Pathfinder's ground map.
+inline bool noFootprintBits(const std::vector<std::uint32_t> &units,
+    const std::vector<std::uint32_t> *terrain, int lanesPerColumn,
+    int minX, int minY, int maxX, int maxY)
+{
+    const int firstLane = minY / 32;
+    const int lastLane = maxY / 32;
+    const auto firstMask = ~std::uint32_t{0} << (minY % 32);
+    const auto lastMask = ~std::uint32_t{0} >> (31 - (maxY % 32));
+    for (int x = minX; x <= maxX; ++x) {
+        const int start = x * lanesPerColumn;
+        for (int lane = firstLane; lane <= lastLane; ++lane) {
+            const int index = start + lane;
+            auto bits = units[index] | (terrain ? (*terrain)[index] : 0u);
+            if (lane == firstLane)
+                bits &= firstMask;
+            if (lane == lastLane)
+                bits &= lastMask;
+            if (bits)
+                return false;
+        }
+    }
+    return true;
+}
diff --git a/Core/GameEngine/Source/GameLogic/AI/RouteComparison.inc b/Core/GameEngine/Source/GameLogic/AI/RouteComparison.inc
new file mode 100644
index 0000000..8b12752
--- /dev/null
+++ b/Core/GameEngine/Source/GameLogic/AI/RouteComparison.inc
@@ -0,0 +1,53 @@
+struct ZoneSnapshot {
+    int columns=0, rows=0;
+    std::vector<unsigned char> passable;
+
+    template<class Read>
+    void capture(int width,int height,Read read)
+    {
+        if (width<=0 || height<=0 || static_cast<long long>(width)*height>1048576) {
+            columns=rows=0;
+            passable.clear();
+            return;
+        }
+        columns=width;
+        rows=height;
+        passable.resize(static_cast<std::size_t>(columns)*rows);
+        for (int x=0;x<columns;++x)
+            for (int y=0;y<rows;++y)
+                passable[x*rows+y]=read(x,y);
+    }
+
+    bool allows(int x,int y,int block) const
+    {
+        const auto valid=[&](int cx,int cy) {
+            const int bx=cx/block, by=cy/block;
+            return bx>=0 && bx<columns && by>=0 && by<rows && passable[bx*rows+by]!=0;
+        };
+        return valid(x,y) || valid(x+3,y+3) || valid(x-3,y+3) || valid(x+3,y-3) || valid(x-3,y-3);
+    }
+};
+
+inline unsigned optimizedMatch(Path *legacy,Path *candidate)
+{
+    if (!legacy || !candidate || legacy->getBlockedByAlly()!=candidate->getBlockedByAlly())
+        return 0;
+    const PathNode *original=legacy->getFirstNode();
+    const PathNode *comparison=candidate->getFirstNode();
+    unsigned nodes=0;
+    while (original && comparison) {
+        const auto &a=*original->getPosition();
+        const auto &b=*comparison->getPosition();
+        if (std::bit_cast<std::uint32_t>(a.x)!=std::bit_cast<std::uint32_t>(b.x) ||
+            std::bit_cast<std::uint32_t>(a.y)!=std::bit_cast<std::uint32_t>(b.y) ||
+            std::bit_cast<std::uint32_t>(a.z)!=std::bit_cast<std::uint32_t>(b.z) ||
+            original->getLayer()!=comparison->getLayer())
+            return 0;
+        ++nodes;
+        if (nodes>1048576)
+            return 0;
+        original=original->getNextOptimized();
+        comparison=comparison->getNextOptimized();
+    }
+    return original || comparison ? 0 : nodes;
+}
diff --git a/Core/GameEngine/Source/GameLogic/AI/RouteGuard.inc b/Core/GameEngine/Source/GameLogic/AI/RouteGuard.inc
new file mode 100644
index 0000000..2d1890b
--- /dev/null
+++ b/Core/GameEngine/Source/GameLogic/AI/RouteGuard.inc
@@ -0,0 +1,283 @@
+// T-112 diagnostic-only request-level group route guard probe.
+//
+// Keeps the legacy solver authoritative. For every ground group request it
+// looks up the latest route with the same cell-level inputs inside a short
+// TTL, checks the cached route cells against the live grid, and records
+// whether the legacy solver would have returned the same route. No cached
+// route is ever applied to gameplay in this build.
+#pragma once
+
+#include <bit>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <unordered_map>
+#include <vector>
+
+namespace routeGuard {
+
+struct Cell {
+    short x = 0;
+    short y = 0;
+    signed char layer = 0;
+};
+
+struct Key {
+    int fromX = 0;
+    int fromY = 0;
+    int toX = 0;
+    int toY = 0;
+    signed char fromLayer = 0;
+    signed char toLayer = 0;
+    short diameter = 0;
+    unsigned char crusher = 0;
+    unsigned revision = 0;
+
+    bool operator==(const Key &other) const
+    {
+        return fromX == other.fromX && fromY == other.fromY &&
+            toX == other.toX && toY == other.toY &&
+            fromLayer == other.fromLayer && toLayer == other.toLayer &&
+            diameter == other.diameter && crusher == other.crusher &&
+            revision == other.revision;
+    }
+};
+
+struct KeyHash {
+    std::size_t operator()(const Key &key) const
+    {
+        std::size_t hash = 1469598103934665603ull;
+        const auto mix = [&](unsigned value) {
+            hash ^= value;
+            hash *= 1099511628211ull;
+        };
+        mix(unsigned(key.fromX));
+        mix(unsigned(key.fromY));
+        mix(unsigned(key.toX));
+        mix(unsigned(key.toY));
+        mix(unsigned(key.fromLayer));
+        mix(unsigned(key.toLayer));
+        mix(unsigned(key.diameter));
+        mix(unsigned(key.crusher));
+        mix(key.revision);
+        return hash;
+    }
+};
+
+struct Entry {
+    unsigned frame = 0;
+    unsigned revision = 0;
+    unsigned fixedRevision = 0;
+    unsigned long long hash = 0;
+    bool returned = false;
+    bool cellsComplete = false;
+    std::vector<Cell> cells;
+};
+
+inline std::unordered_map<Key, Entry, KeyHash> cache;
+inline unsigned lastFrame = 0;
+inline unsigned ordinal = 0;
+
+inline FILE *log()
+{
+    static FILE *file = []() -> FILE * {
+        const char *name = std::getenv("ZH_ROUTE_GUARD_LOG");
+        FILE *output = name ? std::fopen(name, "w") : nullptr;
+        if (output) {
+            std::setvbuf(output, nullptr, _IOFBF, 262144);
+            std::fprintf(output,
+                "frame,ordinal,from_x,from_y,to_x,to_y,revision,fixed_revision,"
+                "hit,age,cached_returned,guard,cells,fail_index,guard_us,"
+                "search_us,exact,cached_hash,new_hash,path_len,returned\n");
+        }
+        return output;
+    }();
+    return file;
+}
+
+inline bool enabled()
+{
+    static const bool value = std::getenv("ZH_ROUTE_GUARD_LOG") != nullptr;
+    return value;
+}
+
+inline unsigned setting(const char *name, unsigned fallback)
+{
+    const char *value = std::getenv(name);
+    return value ? static_cast<unsigned>(std::strtoul(value, nullptr, 10)) : fallback;
+}
+
+inline unsigned firstFrame()
+{
+    static const unsigned value = setting("ZH_ROUTE_GUARD_FIRST", 16978);
+    return value;
+}
+
+inline unsigned lastFrameSetting()
+{
+    static const unsigned value = setting("ZH_ROUTE_GUARD_LAST", 17277);
+    return value;
+}
+
+inline unsigned ttl()
+{
+    static const unsigned value = setting("ZH_ROUTE_GUARD_TTL", 4);
+    return value;
+}
+
+inline unsigned skipCells()
+{
+    static const unsigned value = setting("ZH_ROUTE_GUARD_SKIP", 3);
+    return value;
+}
+
+inline unsigned long long hashPath(Path *path)
+{
+    unsigned long long hash = 14695981039346656037ull;
+    if (path) {
+        for (const PathNode *node = path->getFirstNode(); node; node = node->getNext()) {
+            const Coord3D &pos = *node->getPosition();
+            for (float component : {pos.x, pos.y, pos.z}) {
+                hash ^= std::bit_cast<unsigned>(component);
+                hash *= 1099511628211ull;
+            }
+            hash ^= static_cast<unsigned>(node->getLayer());
+            hash *= 1099511628211ull;
+        }
+    }
+    return hash;
+}
+
+struct Probe {
+    Probe(Pathfinder &pathfinder, const Coord3D &from, const Coord3D &to,
+        int diameter, bool crusher);
+    ~Probe() = default;
+
+    void finish(Path *path);
+
+    Pathfinder &pathfinder;
+    Key key;
+    unsigned frame = 0;
+    unsigned sequence = 0;
+    unsigned revision = 0;
+    unsigned fixedRevision = 0;
+    unsigned age = 0;
+    unsigned cells = 0;
+    bool hit = false;
+    bool guardPass = false;
+    bool cachedReturned = false;
+    int failIndex = -1;
+    double guardUs = 0;
+    unsigned long long cachedHash = 0;
+    LARGE_INTEGER begin{};
+};
+
+inline Probe::Probe(Pathfinder &pathfinder, const Coord3D &from, const Coord3D &to,
+    int diameter, bool crusher)
+    : pathfinder(pathfinder)
+{
+    if (!enabled() || !TheGameLogic || !TheGameLogic->isInReplayGame()) {
+        return;
+    }
+    if (diameter != 6 || crusher) {
+        return; // group ground requests only
+    }
+    frame = TheGameLogic->getFrame();
+    if (frame < firstFrame() || frame > lastFrameSetting()) {
+        return;
+    }
+    if (frame < lastFrame) {
+        cache.clear();
+    }
+    lastFrame = frame;
+
+    ICoord2D fromCell{}, toCell{};
+    pathfinder.worldToCell(&from, &fromCell);
+    pathfinder.worldToCell(&to, &toCell);
+
+    key.fromX = fromCell.x;
+    key.fromY = fromCell.y;
+    key.toX = toCell.x;
+    key.toY = toCell.y;
+    key.fromLayer = LAYER_GROUND;
+    key.toLayer = LAYER_GROUND;
+    key.diameter = short(diameter);
+    key.crusher = 0;
+    key.revision = lastStandCensus::navigationRevision;
+    revision = key.revision;
+    fixedRevision = lastStandCensus::fixedOccupancyRevision;
+    sequence = ++ordinal;
+
+    const auto it = cache.find(key);
+    if (it != cache.end() && frame > it->second.frame &&
+        frame - it->second.frame <= ttl()) {
+        hit = true;
+        age = frame - it->second.frame;
+        cachedReturned = it->second.returned;
+        cachedHash = it->second.hash;
+        cells = unsigned(it->second.cells.size());
+        if (cachedReturned && it->second.cellsComplete) {
+            const auto guardBegin = std::chrono::steady_clock::now();
+            const unsigned skip = skipCells() < cells ? skipCells() : cells;
+            guardPass = true;
+            for (unsigned index = skip; index < cells; ++index) {
+                const Cell &cell = it->second.cells[index];
+                if (pathfinder.clearCellForDiameter(false, cell.x, cell.y,
+                        static_cast<PathfindLayerEnum>(cell.layer), 6) != 6) {
+                    guardPass = false;
+                    failIndex = int(index);
+                    break;
+                }
+            }
+            const auto guardEnd = std::chrono::steady_clock::now();
+            guardUs = std::chrono::duration<double, std::micro>(guardEnd - guardBegin).count();
+        }
+    }
+
+    QueryPerformanceCounter(&begin);
+}
+
+inline void Probe::finish(Path *path)
+{
+    if (!sequence) {
+        return;
+    }
+    LARGE_INTEGER end{}, frequency{};
+    QueryPerformanceCounter(&end);
+    QueryPerformanceFrequency(&frequency);
+    const double searchUs = (end.QuadPart - begin.QuadPart) * 1000000.0 / frequency.QuadPart;
+
+    Entry entry;
+    entry.frame = frame;
+    entry.revision = revision;
+    entry.fixedRevision = fixedRevision;
+    entry.hash = hashPath(path);
+    entry.returned = path != nullptr;
+    entry.cellsComplete = path != nullptr;
+    if (path) {
+        for (const PathNode *node = path->getFirstNode(); node; node = node->getNext()) {
+            ICoord2D cell{};
+            if (pathfinder.worldToCell(node->getPosition(), &cell)) {
+                entry.cellsComplete = false;
+                break;
+            }
+            entry.cells.push_back({short(cell.x), short(cell.y), static_cast<signed char>(node->getLayer())});
+        }
+    }
+
+    const bool exact = hit && cachedReturned && path && cachedHash == entry.hash;
+    std::fprintf(log(),
+        "%u,%u,%d,%d,%d,%d,%u,%u,%u,%u,%u,%d,%u,%d,%.3f,%.3f,%u,%llu,%llu,%u,%u\n",
+        frame, sequence, key.fromX, key.fromY, key.toX, key.toY,
+        revision, fixedRevision, unsigned(hit), age, unsigned(cachedReturned),
+        hit ? (guardPass ? 1 : 0) : -1, cells, failIndex, guardUs, searchUs,
+        unsigned(exact), cachedHash, entry.hash, unsigned(entry.cells.size()),
+        unsigned(entry.returned));
+
+    if (cache.size() > 4096) {
+        cache.clear();
+    }
+    cache[key] = std::move(entry);
+}
+
+} // namespace routeGuard
diff --git a/Core/GameEngine/Source/GameLogic/AI/SearchOverlap.inc b/Core/GameEngine/Source/GameLogic/AI/SearchOverlap.inc
new file mode 100644
index 0000000..93ebc63
--- /dev/null
+++ b/Core/GameEngine/Source/GameLogic/AI/SearchOverlap.inc
@@ -0,0 +1,56 @@
+#include <vector>
+
+namespace searchOverlap {
+
+struct Cell {
+    std::int32_t x, y, layer;
+};
+static_assert(sizeof(Cell) == 12);
+
+enum SearchKind : std::uint32_t { Exact = 1, Closest = 2, Formation = 3 };
+
+FILE *output(unsigned frame)
+{
+    if (frame < 16978 || frame > 17277)
+        return nullptr;
+    static FILE *file = [] {
+        const char *path = std::getenv("ZH_SEARCH_OVERLAP");
+        return path ? std::fopen(path, "wb") : nullptr;
+    }();
+    return file;
+}
+
+class Search {
+public:
+    Search(const zhpf::Trace &trace, SearchKind kind)
+        : m_file(trace.detailed ? output(trace.frame) : nullptr),
+          m_request(trace.counters.request), m_kind(kind)
+    {
+    }
+
+    void visit(int x, int y, int layer)
+    {
+        if (m_file)
+            m_cells.push_back({ x, y, layer });
+    }
+
+    Path *finish(Path *result)
+    {
+        if (!m_file)
+            return result;
+        const std::uint32_t record[]{ m_request, m_kind, result ? 1u : 0u,
+            static_cast<std::uint32_t>(m_cells.size()) };
+        std::fwrite(record, sizeof(record), 1, m_file);
+        if (!m_cells.empty())
+            std::fwrite(m_cells.data(), sizeof(Cell), m_cells.size(), m_file);
+        return result;
+    }
+
+private:
+    FILE *m_file;
+    unsigned m_request;
+    SearchKind m_kind;
+    std::vector<Cell> m_cells;
+};
+
+} // namespace searchOverlap
diff --git a/Core/GameEngine/Source/GameLogic/AI/SpeculativeWorkers.h b/Core/GameEngine/Source/GameLogic/AI/SpeculativeWorkers.h
new file mode 100644
index 0000000..5a56840
--- /dev/null
+++ b/Core/GameEngine/Source/GameLogic/AI/SpeculativeWorkers.h
@@ -0,0 +1,107 @@
+#pragma once
+
+#include <array>
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+#include <optional>
+#include <thread>
+#include <utility>
+
+// The coordinator owns submission and commit. Each worker owns one slot and
+// only sees an immutable snapshot in the submitted job.
+template<class Job, class Result, class Solve>
+class SpeculativeWorkers {
+public:
+    static constexpr size_t laneCount = 8;
+    struct Ticket {
+        size_t lane;
+        uint64_t serial;
+    };
+
+    explicit SpeculativeWorkers(Solve solve)
+    {
+        for (size_t lane = 0; lane < laneCount; ++lane) {
+            workers[lane] = std::jthread([this, lane, solve](std::stop_token stop) mutable {
+                execute(slots[lane], stop, solve);
+            });
+        }
+    }
+
+    std::optional<Ticket> offer(size_t lane, Job input)
+    {
+        Slot &slot = slots.at(lane);
+        std::lock_guard lock(slot.mutex);
+        if (slot.running || slot.job || slot.result)
+            return std::nullopt;
+        ++slot.serial;
+        slot.job.emplace(std::move(input));
+        slot.work.notify_one();
+        return Ticket{lane, slot.serial};
+    }
+
+    bool ready(Ticket ticket)
+    {
+        Slot &slot = slots.at(ticket.lane);
+        std::lock_guard lock(slot.mutex);
+        return slot.serial == ticket.serial && slot.result.has_value();
+    }
+
+    // Poll only when this job reaches its original position in the game queue.
+    // A missing or rejected result leaves that queue slot to the original solver.
+    template<class Validate>
+    std::optional<Result> take(Ticket ticket, Validate validate)
+    {
+        Slot &slot = slots.at(ticket.lane);
+        std::optional<Result> result;
+        {
+            std::lock_guard lock(slot.mutex);
+            if (slot.serial != ticket.serial)
+                return std::nullopt;
+            ++slot.serial;
+            slot.job.reset();
+            result.swap(slot.result);
+        }
+        if (!result || !validate(*result))
+            return std::nullopt;
+        return result;
+    }
+
+private:
+    struct Slot {
+        std::mutex mutex;
+        std::condition_variable_any work;
+        uint64_t serial = 0;
+        bool running = false;
+        std::optional<Job> job;
+        std::optional<Result> result;
+    };
+
+    static void execute(Slot &slot, std::stop_token stop, Solve &solve)
+    {
+        std::unique_lock lock(slot.mutex);
+        while (slot.work.wait(lock, stop, [&] { return slot.job.has_value(); })) {
+            if (stop.stop_requested())
+                return;
+            auto job = std::move(*slot.job);
+            const auto serial = slot.serial;
+            slot.job.reset();
+            slot.running = true;
+            lock.unlock();
+            std::optional<Result> result;
+            try {
+                result.emplace(solve(job));
+            } catch (...) {
+                // A failed worker attempt is indistinguishable from a missing
+                // result to the coordinator, which keeps the serial fallback.
+            }
+            lock.lock();
+            slot.running = false;
+            if (serial == slot.serial)
+                slot.result.swap(result);
+        }
+    }
+
+    std::array<Slot, laneCount> slots;
+    std::array<std::jthread, laneCount> workers;
+};
diff --git a/Core/GameEngine/Source/GameLogic/AI/UnitMaskProbe.inc b/Core/GameEngine/Source/GameLogic/AI/UnitMaskProbe.inc
new file mode 100644
index 0000000..f74e6af
--- /dev/null
+++ b/Core/GameEngine/Source/GameLogic/AI/UnitMaskProbe.inc
@@ -0,0 +1,93 @@
+namespace unitMaskProbe {
+
+enum class Mode { Disabled, Verify, Fast };
+
+static Mode readMode(const char *name)
+{
+    const char *value=std::getenv(name);
+    if (value && std::strcmp(value,"verify")==0)
+        return Mode::Verify;
+    if (value && std::strcmp(value,"on")==0)
+        return Mode::Fast;
+    return Mode::Disabled;
+}
+
+static Mode mode()
+{
+    static const Mode setting=readMode("ZH_UNIT_MASK");
+    return setting;
+}
+
+static Mode neighborMode()
+{
+    static const Mode setting=readMode("ZH_NEIGHBOR_BATCH");
+    return setting;
+}
+
+struct Counts {
+    unsigned calls=0, eligible=0, empty=0, mismatch=0;
+};
+
+struct NeighborCounts {
+    unsigned expansions=0,direct=0,wholeBlock=0,difference=0;
+};
+
+struct Frame {
+    unsigned tick=0;
+    Counts movement, destination;
+    NeighborCounts neighbors;
+
+    void write() const
+    {
+        static FILE *output=[] {
+            const char *path=std::getenv("ZH_UNIT_MASK_LOG");
+            FILE *file=path && *path ? std::fopen(path,"w") : nullptr;
+            if (file)
+                std::fprintf(file,"frame,movement_calls,movement_eligible,movement_empty,movement_mismatch,destination_calls,destination_eligible,destination_empty,destination_mismatch,neighbor_expansions,neighbor_direct,neighbor_whole_block,neighbor_difference\n");
+            return file;
+        }();
+        if (output) {
+            std::fprintf(output,"%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u\n",tick,
+                movement.calls,movement.eligible,movement.empty,movement.mismatch,
+                destination.calls,destination.eligible,destination.empty,destination.mismatch,
+                neighbors.expansions,neighbors.direct,neighbors.wholeBlock,neighbors.difference);
+            if (tick%30==0 || tick==17277)
+                std::fflush(output);
+        }
+    }
+};
+
+inline Frame frame;
+
+static Frame *activeFrame()
+{
+    if (!TheGameLogic)
+        return nullptr;
+    const unsigned tick=TheGameLogic->getFrame();
+    if (frame.tick && frame.tick!=tick) {
+        frame.write();
+        frame={};
+    }
+    if (tick<16978 || tick>17277)
+        return nullptr;
+    frame.tick=tick;
+    return &frame;
+}
+
+static Counts *sample(bool destination)
+{
+    auto *active=activeFrame();
+    if (!active)
+        return nullptr;
+    auto &counts=destination?active->destination:active->movement;
+    ++counts.calls;
+    return &counts;
+}
+
+static NeighborCounts *sampleNeighbors()
+{
+    auto *active=activeFrame();
+    return active?&active->neighbors:nullptr;
+}
+
+} // namespace unitMaskProbe
