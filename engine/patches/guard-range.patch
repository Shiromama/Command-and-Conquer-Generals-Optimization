+// T-081: guard uses automatic combat weapons, not helper/manual-only weapon ranges.
+static Real getAutomaticGuardWeaponRange(const Object* obj)
+{
+    Real range = 0.0f;
+    const Bool locked = obj->isCurWeaponLocked();
+    const Weapon* lockedWeapon = locked ? obj->getCurrentWeapon() : nullptr;
+    for (Int i = PRIMARY_WEAPON; i < WEAPONSLOT_COUNT; ++i)
+    {
+        const WeaponSlotType slot = static_cast<WeaponSlotType>(i);
+        const Weapon* weapon = obj->getWeaponInWeaponSlot(slot);
+        if (!weapon || (locked && weapon != lockedWeapon))
+            continue;
+        if (!locked && !(obj->getWeaponInWeaponSlotCommandSourceMask(slot) & (1u << CMD_FROM_AI)))
+            continue;
+        if (!weapon->isDamageWeapon() || weapon->getAntiMask() == 0)
+            continue;
+        if (weapon->getStatus() == OUT_OF_AMMO && !weapon->getAutoReloadsClip())
+            continue;
+        const Real candidate = weapon->getAttackRange(obj); // Includes current range bonuses.
+        if (std::isfinite(candidate) && candidate > range)
+            range = candidate;
+    }
+    return range;
+}
+
 /*static*/ Real AIGuardMachine::getStdGuardRange(const Object* obj)
 {
-	Real visionRange = TheAI->getAdjustedVisionRangeForObject(obj,
-		AI_VISIONFACTOR_OWNERTYPE | AI_VISIONFACTOR_MOOD | AI_VISIONFACTOR_GUARDINNER);
-
-	return visionRange;
+    if (!obj || !obj->getAI() || !TheAI)
+        return 0.0f;
+    const Real guardRange = TheAI->getAdjustedVisionRangeForObject(obj,
+        AI_VISIONFACTOR_OWNERTYPE | AI_VISIONFACTOR_MOOD | AI_VISIONFACTOR_GUARDINNER);
+
+    // Built-in singleplayer fix; preserve network/replay, AI difficulty and enter/hijack behavior.
+    if (!TheGameLogic || !TheGameLogic->isInGame() || TheGameLogic->isInShellGame()
+        || TheGameLogic->isInMultiplayerGame() || TheGameLogic->isInReplayGame()
+        || !(obj->getAI()->getMoodMatrixValue() & MM_Controller_Player)
+        || obj->getTemplate()->isEnterGuard())
+        return guardRange;
+
+    const Real weaponRange = getAutomaticGuardWeaponRange(obj);
+    return weaponRange > guardRange ? weaponRange : guardRange;
 }
 
